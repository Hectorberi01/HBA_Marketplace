<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    `FrameworkReference` plutôt que des paquets : la propagation d'en-têtes a
    besoin d'`IHttpContextAccessor`, et le filtre de configuration YARP
    d'`IProxyConfigFilter`. C'est la couche technique — elle a le droit de
    connaître ASP.NET Core. Application, elle, ne l'a pas.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Timeouts, disjoncteur, réessais (Polly v8 sous le capot). -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />

    <!-- Nécessaire pour IProxyConfigFilter : les adresses viennent de Services:*. -->
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HBA.Gateway.Application\HBA.Gateway.Application.csproj" />
    <!--
      AJOUTEES POUR QUE LA PASSERELLE CONSOMME `TokenRevoked`.

      `HBA.Shared.Infrastructure` apporte le consommateur Kafka et le
      repartiteur ; `HBA.Identity.Contracts` le type de l'evenement. C'est un
      poids reel sur le composant en frontal — EF Core et Npgsql entrent par la
      meme porte, sans etre utilises. Le trier a la main donnerait une seconde
      façon d'assembler le socle : voir `Messaging/Kafka/DependencyInjection`.
    -->
    <ProjectReference Include="..\..\..\..\shared\common\HBA.Shared.Infrastructure\HBA.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\shared\contracts\HBA.Identity.Contracts\HBA.Identity.Contracts.csproj" />
  </ItemGroup>


  <!-- LES CLIENTS gRPC DE CE SERVICE (lot C). Les stubs et les adaptateurs
       vivent encore dans les assemblages de contrats ; le CABLAGE, lui, est
       ici, dans Grpc/. -->
  <ItemGroup>
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\shared\proto\identity\v1\identity.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\shared\common\HBA.Shared.Hosting\HBA.Shared.Hosting.csproj" />
  </ItemGroup>


  <!-- LE CACHE DE CE SERVICE (Caching/Redis/). Ces paquets venaient
       transitivement de HBA.Shared.Infrastructure ; ils sont explicites
       depuis que l'implementation est ici. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>


  <!-- L'OBSERVABILITE DE CE SERVICE (Observability/). Les sondes
       interrogent vraiment le courtier et le cache ; ces paquets venaient
       transitivement du socle. -->
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>

</Project>
