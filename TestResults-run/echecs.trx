      SELECT s."Id", s."CreatedOnUtc", s."Description", s."IsSystemRole", s."Name", s."Scope", s."SellerId", s."UpdatedOnUtc", s.xmin, r."SellerRoleId", r."Permission"
      FROM sellers.seller_roles AS s
