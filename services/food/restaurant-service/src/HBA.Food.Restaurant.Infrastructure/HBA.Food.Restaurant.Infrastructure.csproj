<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HBA.Food.Restaurant.Domain\HBA.Food.Restaurant.Domain.csproj" />
    <ProjectReference Include="..\HBA.Food.Restaurant.Contracts\HBA.Food.Restaurant.Contracts.csproj" />
    <ProjectReference Include="..\HBA.Food.Restaurant.Application\HBA.Food.Restaurant.Application.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Infrastructure\HBA.Shared.Infrastructure.csproj" />
    <!--
      CES REFERENCES SONT ARRIVEES AVEC LES CONSOMMATEURS, ET C'EST UNE FRONTIERE
      OUVERTE.

      Les gestionnaires d'evenements de ce service vivaient dans `Api/Integration`,
      ou le composition root avait le droit de tout connaître. Les ranger dans
      `Infrastructure/Messaging/Kafka/Consumers` — la convention du depot — oblige
      ce projet a connaître les contrats des services qu'il ECOUTE.

      CE QUI TIENT ENCORE. Ce sont des projets de CONTRATS : des records
      d'evenements, pas des services. Aucun appel reseau n'entre par la, et le
      couplage est confine a `Messaging/Kafka/` — il se supprime en supprimant ce
      dossier. Si la frontiere doit redevenir opposable, c'est un test
      d'architecture qu'il faut ecrire, pas un commentaire.
    -->
    <ProjectReference Include="..\..\..\..\delivery\delivery-service\src\HBA.Deliveries.Contracts\HBA.Deliveries.Contracts.csproj" />
    <ProjectReference Include="..\..\..\food-order-service\src\HBA.Food.Order.Contracts\HBA.Food.Order.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\marketplace\inventory-service\src\HBA.Inventory.Contracts\HBA.Inventory.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\marketplace\order-service\src\HBA.Order.Contracts\HBA.Order.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\marketplace\order-service\src\HBA.Ordering.Contracts\HBA.Ordering.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="MediatR" />
    <!-- Requis par `Messaging/Kafka/Configuration/GardeDeCablage.cs` (IHostedService).
         Le paquet arrivait de facon transitive ; une dependance transitive
         disparaît sans prevenir quand le projet amont change. Declaree, donc. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>


  <!-- LES CLIENTS gRPC DE CE SERVICE (lot C). Les stubs et les adaptateurs
       vivent encore dans les assemblages de contrats ; le CABLAGE, lui, est
       ici, dans Grpc/. -->
  <ItemGroup>
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\delivery\v1\delivery.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Hosting\HBA.Shared.Hosting.csproj" />
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\foodorder\v1\foodorder.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\inventory\v1\inventory.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
