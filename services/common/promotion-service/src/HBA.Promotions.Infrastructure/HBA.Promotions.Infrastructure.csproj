<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cadre cible, nullable et usings implicites viennent de Directory.Build.props.

    Ce projet ne référence AUCUN autre service, pas même leurs contrats. Les deux
    événements consommés — `marketplace.order.cancelled` et `food.order.cancelled`
    — sont traités par l'Api, qui a le droit de connaître les contrats des services
    dont elle écoute les faits. Faire descendre cette dépendance ici aurait lié la
    persistance de promotion au vocabulaire de deux autres domaines.
  -->
  <ItemGroup>
    <ProjectReference Include="..\HBA.Promotions.Domain\HBA.Promotions.Domain.csproj" />
    <ProjectReference Include="..\HBA.Promotions.Application\HBA.Promotions.Application.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\contracts\HBA.Promotions.Contracts\HBA.Promotions.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Infrastructure\HBA.Shared.Infrastructure.csproj" />
    <!--
      CES REFERENCES SONT ARRIVEES AVEC LES CONSOMMATEURS, ET C'EST UNE FRONTIERE
      OUVERTE.

      Les gestionnaires d'evenements de ce service vivaient dans `Api/Integration`,
      ou le composition root avait le droit de tout connaître. Les ranger dans
      `Infrastructure/Messaging/Kafka/Consumers` — la convention du depot — oblige
      ce projet a connaître les contrats des services qu'il ECOUTE.

      CE QUI TIENT ENCORE. Ce sont des projets de CONTRATS : des records
      d'evenements, pas des services. Aucun appel reseau n'entre par la, et le
      couplage est confine a `Messaging/Kafka/` — il se supprime en supprimant ce
      dossier. Si la frontiere doit redevenir opposable, c'est un test
      d'architecture qu'il faut ecrire, pas un commentaire.
    -->
    <ProjectReference Include="..\..\..\..\food\restaurant-service\src\HBA.Food.Restaurant.Contracts\HBA.Food.Restaurant.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\marketplace\order-service\src\HBA.Order.Contracts\HBA.Order.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="MediatR" />

    <!--
      AJOUTÉS POUR LE BALAYEUR DE RETENUES (ISSUE-053), ET RIEN D'AUTRE.

      `BackgroundService` vit dans `Hosting.Abstractions`, `ILogger<T>` dans
      `Logging.Abstractions`. Ce projet n'en tirait aucun : promotion n'avait
      jamais eu de travail d'arrière-plan à lui (l'outbox vient du socle, qui les
      référence pour son propre compte). Sans ces deux lignes, la compilation
      échoue en CS0246 sur `BackgroundService` — et le message ne nomme pas le
      paquet manquant.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>


  <!-- LES CLIENTS gRPC DE CE SERVICE (lot C). Les stubs et les adaptateurs
       vivent encore dans les assemblages de contrats ; le CABLAGE, lui, est
       ici, dans Grpc/. -->
  <ItemGroup>
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\merchant\v1\merchant.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Hosting\HBA.Shared.Hosting.csproj" />
    <ProjectReference Include="..\..\..\..\marketplace\seller-service\src\HBA.Merchants.Contracts\HBA.Merchants.Contracts.csproj" />
  </ItemGroup>

</Project>
