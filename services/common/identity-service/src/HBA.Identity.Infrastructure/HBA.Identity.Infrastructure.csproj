<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure : EF Core, repositories, hasher BCrypt, JWT, TOTP, DI du
       module. Référence Application + Domain + Contracts + BuildingBlocks.Infra. -->
  <ItemGroup>
    <ProjectReference Include="..\HBA.Identity.Domain\HBA.Identity.Domain.csproj" />
    <ProjectReference Include="..\HBA.Identity.Application\HBA.Identity.Application.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\contracts\HBA.Identity.Contracts\HBA.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Infrastructure\HBA.Shared.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="Otp.NET" />
    <!-- Requis par `Messaging/Kafka/Configuration/GardeDeCablage.cs` (IHostedService).
         Le paquet arrivait de facon transitive ; une dependance transitive
         disparaît sans prevenir quand le projet amont change. Declaree, donc. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>


  <!-- LE CACHE DE CE SERVICE (Caching/Redis/). Ces paquets venaient
       transitivement de HBA.Shared.Infrastructure ; ils sont explicites
       depuis que l'implementation est ici. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>


  <!-- L'OBSERVABILITE DE CE SERVICE (Observability/). Les sondes
       interrogent vraiment le courtier et le cache ; ces paquets venaient
       transitivement du socle. -->
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>


  <!-- LES SONDES DE SANTE VIENNENT DU FRAMEWORK, PAS D'UN PAQUET.
       `IHealthCheck`, `HealthCheckResult` et `AddHealthChecks()` sont fournis
       par Microsoft.AspNetCore.App. Les demander en PackageReference sous
       gestion centralisee des versions donne NU1008 : le SDK en pose deja une
       reference implicite, avec sa version. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
