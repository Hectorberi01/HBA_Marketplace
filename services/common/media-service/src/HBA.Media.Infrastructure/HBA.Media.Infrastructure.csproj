    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />

    <!--
      PAS DE « Microsoft.Extensions.Options » ICI.
      La gestion centralisée des versions (Directory.Packages.props) n'en déclare
      aucune, et un PackageReference sans PackageVersion correspondant fait
      échouer la restauration (NU1008). IOptions<T> arrive de toute façon par
      transitivité — c'est ce que fait déjà Sellers pour son stockage R2, qui
      utilise IOptions sans le référencer.

      Le service hébergé qui signale un stockage non configuré exige, lui,
      Hosting.Abstractions — comme Deliveries pour ses services de fond.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="MediatR" />

    <!--
      SkiaSharp, et non ImageSharp : le choix est déjà argumenté dans
      Directory.Packages.props. ImageSharp est passé en licence commerciale ;
      SkiaSharp reste MIT sans condition. La variante « NoDependencies » embarque
      son libSkiaSharp.so, ce qui évite d'installer des paquets système dans
      l'image de conteneur.
    -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

</Project>
