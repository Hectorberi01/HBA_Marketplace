<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HBA.Users.Application\HBA.Users.Application.csproj" />
    <ProjectReference Include="..\HBA.Users.Infrastructure\HBA.Users.Infrastructure.csproj" />
    <!--
      IDENTITY N'EST RÉFÉRENCÉ QUE PAR CE PROJET-CI, ET C'EST LA RÈGLE.

      CE COMMENTAIRE DECRIVAIT UN MONDE QUI N'EXISTE PLUS.

      Il citait `UsersBoundaryTests` — un test ABSENT du depot — et situait le
      couplage dans `Api/Integration/`, dossier supprime depuis. Les consommateurs
      vivent maintenant dans `Infrastructure/Messaging/Kafka/Consumers/`, qui
      porte sa propre reference aux contrats d'Identity.

      CE QUI RESTE ICI, ET POURQUOI. `HBA.Identity.Contracts` seul : les types
      d'evenements consommes. La reference `.Grpc` a ete RETIREE avec le client
      qu'elle servait — ce service n'appelle plus identity-service, il ecoute ses
      evenements. Un contrat partage n'est pas un appel reseau.
    -->
    <ProjectReference Include="..\..\..\identity-service\src\HBA.Identity.Contracts\HBA.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Hosting\HBA.Shared.Hosting.csproj" />
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\user\v1\user.proto" GrpcServices="Server" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HBA.Users.Contracts\HBA.Users.Contracts.csproj" />
  </ItemGroup>

</Project>
