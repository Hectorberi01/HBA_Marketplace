<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\HBA.Inventory.Domain\HBA.Inventory.Domain.csproj" />
    <ProjectReference Include="..\HBA.Inventory.Application\HBA.Inventory.Application.csproj" />
    <ProjectReference Include="..\HBA.Inventory.Contracts\HBA.Inventory.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Infrastructure\HBA.Shared.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />

    <!--
      AJOUTÉS POUR LE BALAYEUR D'EXPIRATION (ISSUE-031), ET RIEN D'AUTRE.

      `BackgroundService` vit dans `Hosting.Abstractions`, `ILogger<T>` dans
      `Logging.Abstractions`. Ce projet n'en tirait aucun : inventory n'avait
      jamais eu de travail d'arrière-plan à lui (l'outbox vient du socle, qui les
      référence pour son propre compte). Sans ces deux lignes, la compilation
      échoue en CS0246 sur `BackgroundService` — et le message ne nomme pas le
      paquet manquant.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- LES CLIENTS gRPC DE CE SERVICE (lot C). Les stubs et les adaptateurs
       vivent encore dans les assemblages de contrats ; le CABLAGE, lui, est
       ici, dans Grpc/. -->
  <ItemGroup>
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\merchant\v1\merchant.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Hosting\HBA.Shared.Hosting.csproj" />
    <ProjectReference Include="..\..\..\seller-service\src\HBA.Merchants.Contracts\HBA.Merchants.Contracts.csproj" />
  </ItemGroup>


  <!-- LE CACHE DE CE SERVICE (Caching/Redis/). Ces paquets venaient
       transitivement de HBA.Shared.Infrastructure ; ils sont explicites
       depuis que l'implementation est ici. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

</Project>
