{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hbaexpress.local/contracts/marketplace/refund-events-v1.json",
  "title": "Marketplace Refund Events V1",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "producer", "aggregate", "partitionKey", "data"],
  "properties": {
    "eventId": { "type": "string" },
    "eventType": {
      "enum": [
        "marketplace.refund.requested",
        "marketplace.refund.succeeded",
        "marketplace.refund.failed"
      ]
    },
    "eventVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "return-refund-service" },
    "aggregate": {
      "type": "object",
      "required": ["type", "id", "version"],
      "properties": {
        "type": { "const": "Refund" },
        "id": { "type": "string" },
        "version": { "type": "integer" }
      }
    },
    "partitionKey": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["returnId", "refundId", "orderId", "amount", "currency", "status"],
      "properties": {
        "returnId": { "type": "string" },
        "refundId": { "type": "string" },
        "orderId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  }
}
