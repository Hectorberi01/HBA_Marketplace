<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HBA.Commerce.Application\HBA.Commerce.Application.csproj" />
    <ProjectReference Include="..\HBA.Commerce.Infrastructure\HBA.Commerce.Infrastructure.csproj" />
    <!--
      AJOUTÉ POUR BRANCHER LA TARIFICATION SUR promotion-service (ISSUE-033).

      C'est le composition root qui choisit le transport : `AddPromotionGrpcClient`
      enregistre `IPromotionModuleApi` sur le client gRPC. L'Infrastructure, elle,
      ne connaît que l'interface — voir le commentaire de son `.csproj`.
    -->
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Hosting\HBA.Shared.Hosting.csproj" />
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\commerce\v1\commerce.proto" GrpcServices="Server" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HBA.Commerce.Contracts\HBA.Commerce.Contracts.csproj" />
  </ItemGroup>

</Project>
