    <ProjectReference Include="..\..\..\catalog-service\src\HBA.Catalog.Contracts\HBA.Catalog.Contracts.csproj" />
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
