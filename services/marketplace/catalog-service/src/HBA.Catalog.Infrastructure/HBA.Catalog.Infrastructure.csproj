<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HBA.Catalog.Domain\HBA.Catalog.Domain.csproj" />
    <ProjectReference Include="..\HBA.Catalog.Application\HBA.Catalog.Application.csproj" />
    <ProjectReference Include="..\HBA.Catalog.Contracts\HBA.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Infrastructure\HBA.Shared.Infrastructure.csproj" />

    <!--
      LE CONTRAT D'INVENTAIRE — SANS LUI, AUCUNE OFFRE NE PASSE JAMAIS EN
      RUPTURE (ISSUE-047).

      `StockDepleted` et `StockReplenished` sont publiés depuis toujours par
      inventory-service, et catalog n'enregistrait AUCUN consommateur de stock. Le
      répartiteur résout paresseusement : l'événement était marqué traité et
      disparaissait, sans erreur.

      Comme le retour de course chez restaurant-service, le consommateur Kafka
      résout l'événement par RÉFLEXION sur les assemblies chargées : sans cette
      référence, catalog-service cesserait simplement de reconnaître ces deux
      messages, sans la moindre erreur de compilation.

      Sens de la dépendance sûr : `HBA.Inventory.Contracts` ne référence que le
      socle, et inventory ne référence rien de catalog.
    -->
    <ProjectReference Include="..\..\..\inventory-service\src\HBA.Inventory.Contracts\HBA.Inventory.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Détourage local : aplatissement sur blanc + encodage JPEG (RembgImageProcessor). -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <!-- Requis par `Messaging/Kafka/Configuration/GardeDeCablage.cs` (IHostedService).
         Le paquet arrivait de facon transitive ; une dependance transitive
         disparaît sans prevenir quand le projet amont change. Declaree, donc. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>


  <!-- LES CLIENTS gRPC DE CE SERVICE (lot C). Les stubs et les adaptateurs
       vivent encore dans les assemblages de contrats ; le CABLAGE, lui, est
       ici, dans Grpc/. -->
  <ItemGroup>
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\media\v1\media.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Hosting\HBA.Shared.Hosting.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\contracts\HBA.Media.Contracts\HBA.Media.Contracts.csproj" />
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\merchant\v1\merchant.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\seller-service\src\HBA.Merchants.Contracts\HBA.Merchants.Contracts.csproj" />
  </ItemGroup>


  <!-- LE CACHE DE CE SERVICE (Caching/Redis/). Ces paquets venaient
       transitivement de HBA.Shared.Infrastructure ; ils sont explicites
       depuis que l'implementation est ici. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

</Project>
