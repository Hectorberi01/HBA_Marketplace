<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HBA.Catalog.Application\HBA.Catalog.Application.csproj" />
    <ProjectReference Include="..\HBA.Catalog.Infrastructure\HBA.Catalog.Infrastructure.csproj" />
    <!--
      LE CONTRAT ÉTAIT DÉJÀ LÀ, PAS LE CLIENT.

      `HBA.Merchants.Contracts` arrive transitivement par HBA.Catalog.Application,
      et le `COPY` du Dockerfile ainsi que `SERVICES__MERCHANT` existent depuis
      longtemps. Seul le projet .Grpc — qui porte `AddMerchantsGrpcClient` —
      manquait. C'est lui qui rend `ISellerModuleApi` résoluble à l'exécution.
    -->
    <!--
      Même schéma pour le média : le contrat arrive transitivement par
      HBA.Catalog.Application, le client gRPC — donc `AddMediaGrpcClient` — vient
      d'ici. Sans lui, `IMediaModuleApi` n'est pas résoluble et le rattachement
      d'image échoue à l'exécution, pas à la compilation.
    -->
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Hosting\HBA.Shared.Hosting.csproj" />
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\catalog\v1\catalog.proto" GrpcServices="Server" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\shared\contracts\HBA.Products.Contracts\HBA.Products.Contracts.csproj" />
    <ProjectReference Include="..\HBA.Catalog.Contracts\HBA.Catalog.Contracts.csproj" />
  </ItemGroup>

</Project>
