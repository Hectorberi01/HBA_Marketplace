<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HBA.Merchants.Application\HBA.Merchants.Application.csproj" />
    <ProjectReference Include="..\HBA.Merchants.Infrastructure\HBA.Merchants.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Hosting\HBA.Shared.Hosting.csproj" />
    <!--
      LE CONTRAT MÉDIA EST RÉFÉRENCÉ PAR HBA.Merchants.Application ; LE CLIENT
      gRPC — donc `AddMediaGrpcClient` — VIENT D'ICI.

      Sans lui, `IMediaModuleApi` n'est pas résoluble et le rattachement d'une
      pièce KYB casse à la CONSTRUCTION de l'hôte, pas au premier appel. Même
      découpage que chez catalog : la couche métier connaît le contrat, la
      composition root connaît le transport.
    -->
    <!-- Même découpage pour Inventory : le contrat côté Application, le transport ici. -->
    <!--
      Et pour Ordering : `SellerSalesCountHandler` recalcule le compteur de ventes
      depuis la source à chaque commande confirmée, plutôt que d'incrémenter.
    -->
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\merchant\v1\merchant.proto" GrpcServices="Server" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HBA.Merchants.Contracts\HBA.Merchants.Contracts.csproj" />
  </ItemGroup>

</Project>
