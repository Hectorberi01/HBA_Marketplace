<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ══════════════════════════════════════════════════════════════════════════
    LA RÉFÉRENCE VERS `HBA.Delivery.Driver.Domain` A ÉTÉ RETIRÉE (lot 5.4).

    `DeliveryGrpcService` importe `HBA.Deliveries.Domain.Drivers` : ce namespace
    est désormais servi par `HBA.Delivery.Core.Domain`, atteint de façon
    transitive par Application et Infrastructure. Le `using` ne change pas ;
    ce qui change, c'est qu'il ne fait plus entrer un second service dans
    l'image.
    ══════════════════════════════════════════════════════════════════════════
  -->
  <ItemGroup>
    <ProjectReference Include="..\HBA.Delivery.Core.Application\HBA.Delivery.Core.Application.csproj" />
    <ProjectReference Include="..\HBA.Delivery.Core.Infrastructure\HBA.Delivery.Core.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Hosting\HBA.Shared.Hosting.csproj" />

    <!-- Types générés depuis delivery.proto : le serveur gRPC vit ici, pas dans
         `src/shared`, parce qu'il envoie des commandes MediatR. -->
  </ItemGroup>


  <!-- CE SERVICE COMPILE LUI-MEME LE CONTRAT (lot D). `Access="Internal"` :
       voir l'encadre des fichiers de Grpc/. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\..\shared\proto\delivery\v1\delivery.proto" GrpcServices="Server" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HBA.Deliveries.Contracts\HBA.Deliveries.Contracts.csproj" />
  </ItemGroup>

</Project>
