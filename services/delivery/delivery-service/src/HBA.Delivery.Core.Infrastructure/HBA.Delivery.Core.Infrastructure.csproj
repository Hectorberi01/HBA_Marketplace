<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ══════════════════════════════════════════════════════════════════════════
    MÊMES DEUX RÉFÉRENCES RETIRÉES QU'EN Application (lot 5.4, ISSUE-069).

    C'est ici que se voyait le plus clairement l'anomalie d'ISSUE-070 : la table
    `deliveries.drivers` est configurée, migrée et lue par CE service
    (`DriverConfiguration`, `DeliveriesDbContext.Drivers`), alors que la classe
    `Driver` était rangée dans le dossier de driver-service — qui ne l'a jamais
    lue. La classe a rejoint la table ; le schéma, lui, n'a pas bougé d'un
    octet, donc AUCUNE MIGRATION n'accompagne ce lot.
    ══════════════════════════════════════════════════════════════════════════
  -->
  <ItemGroup>
    <ProjectReference Include="..\HBA.Delivery.Core.Domain\HBA.Delivery.Core.Domain.csproj" />
    <ProjectReference Include="..\HBA.Deliveries.Contracts\HBA.Deliveries.Contracts.csproj" />
    <ProjectReference Include="..\HBA.Delivery.Core.Application\HBA.Delivery.Core.Application.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\contracts\HBA.DeliveryPricing.Contracts.Grpc\HBA.DeliveryPricing.Contracts.Grpc.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Infrastructure\HBA.Shared.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- BackgroundService, pour la boucle de dispatch. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!--
      IHttpClientFactory, pour les webhooks partenaires. Même version centrale
      que Payments, Catalog et Notifications, qui appellent aussi des tiers.

      La FABRIQUE et non un HttpClient : construit à la main par appel, il épuise
      les sockets ; en statique, il ne voit jamais un changement de DNS — ce qui
      compte quand on appelle des hébergeurs de sites marchands.
    -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
  </ItemGroup>

</Project>
