<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HBA.Delivery.Pricing.Domain\HBA.Delivery.Pricing.Domain.csproj" />
    <ProjectReference Include="..\HBA.Delivery.Pricing.Application\HBA.Delivery.Pricing.Application.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.Infrastructure\HBA.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\..\shared\common\HBA.Shared.IntegrationEvents\HBA.Shared.IntegrationEvents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />

    <!--
      `IOptions<T>` et `Options.Create` sont utilisés explicitement par
      `DeliveryPricingInfrastructureModule` et `EfDeliveryPricingStore`. Ils
      arrivaient probablement par transitivité via EF Core ; un projet qui se
      sert d'un type déclare le paquet qui le porte, sans quoi une mise à jour de
      la dépendance intermédiaire casse une compilation sans rapport apparent.
      Pas d'attribut Version : la gestion centralisée le refuserait (NU1008).
    -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Requis par `Messaging/Kafka/Configuration/GardeDeCablage.cs` (IHostedService).
         Le paquet arrivait de facon transitive ; une dependance transitive
         disparaît sans prevenir quand le projet amont change. Declaree, donc. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>


  <!-- LE CACHE DE CE SERVICE (Caching/Redis/). Ces paquets venaient
       transitivement de HBA.Shared.Infrastructure ; ils sont explicites
       depuis que l'implementation est ici. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>


  <!-- L'OBSERVABILITE DE CE SERVICE (Observability/). Les sondes
       interrogent vraiment le courtier et le cache ; ces paquets venaient
       transitivement du socle. -->
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

</Project>
