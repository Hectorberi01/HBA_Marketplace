<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      INTERNET ÉTAIT ABSENTE DE CE MANIFESTE — ET C'ÉTAIT UN BUG BLOQUANT.

      Le gabarit Flutter ne déclare cette permission que dans les manifestes `debug` et
      `profile` (elle y sert au débogueur). Le manifeste `main` — le SEUL fusionné dans
      un build RELEASE — ne l'avait pas.

      Conséquence : l'application vendeur, compilée en release pour le Play Store,
      n'aurait eu AUCUN accès réseau. Elle se serait lancée normalement, puis aurait
      échoué sur chaque appel — connexion comprise. Et le bug était invisible en
      développement, puisque le manifeste `debug`, lui, portait la permission.

      C'est le genre de défaut qu'on ne découvre qu'après publication, par les avis.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Position FACULTATIVE : elle complète le point de repère pour aider le
         coursier. Un refus n'empêche ni de commander ni de vendre — voir
         `LocationPicker`, qui traite explicitement le refus. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!--
      Android 13+ : sans cette permission, l'application ne peut pas même DEMANDER
      l'autorisation d'afficher des notifications — le système les supprime en silence.
      L'app embarque Firebase Messaging : sans cette ligne, le vendeur n'aurait jamais
      été prévenu d'une nouvelle commande.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Canal de notification par défaut utilisé par FCM quand l'app est en
             arrière-plan / fermée et que le serveur n'en précise aucun. Sans cette
             clé, Android journalise un avertissement et retombe sur un canal
             générique ; ici le comportement est déterministe. Le canal est créé
             automatiquement par FCM à la première notification s'il n'existe pas. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hba_default" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
