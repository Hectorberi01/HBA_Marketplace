<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Options d'export de l'IPA pour TestFlight / App Store.

  POURQUOI CE FICHIER — il MANQUAIT ici alors qu'il existe côté vendeur.

  Sans lui, `flutter build ipa` peut exporter une archive signée en DÉVELOPPEMENT
  (aps-environment=development, get-task-allow=true). Une telle application,
  distribuée par TestFlight, n'obtient AUCUN jeton APNs exploitable : elle
  s'installe, fonctionne parfaitement, et ne reçoit jamais la moindre
  notification. L'échec est entièrement silencieux — c'est ce qui le rend
  coûteux, parce qu'on l'attribue d'abord au serveur.

  `build-ipa.sh` détectait déjà le problème APRÈS coup, en inspectant le profil
  embarqué dans l'IPA. C'était un bon filet, mais il arrivait trop tard : il
  fallait recompiler. Ce fichier l'empêche en amont.

  method=app-store force une signature de DISTRIBUTION : l'export produit alors
  aps-environment=production (et get-task-allow=false).

  Prérequis : un certificat « Apple Distribution » dans le trousseau
  (Xcode → Settings → Accounts → Manage Certificates → + Apple Distribution).
  En signature automatique, Xcode génère ou télécharge le profil requis.
-->
<plist version="1.0">
<dict>
  <key>method</key>
  <string>app-store</string>

  <key>signingStyle</key>
  <string>automatic</string>

  <key>teamID</key>
  <string>QSVS3QW2NQ</string>

  <key>uploadSymbols</key>
  <true/>

  <key>stripSwiftSymbols</key>
  <true/>

  <key>destination</key>
  <string>export</string>
</dict>
</plist>
