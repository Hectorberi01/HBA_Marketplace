<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  NSAppTransportSecurity / NSAllowsArbitraryLoads A ÉTÉ RETIRÉ.

	  Cette clé DÉSACTIVAIT App Transport Security dans toute l'application : iOS
	  cessait d'exiger le HTTPS. C'était un vestige du développement local, et le
	  commentaire annonçait déjà son retrait — qui n'avait jamais eu lieu.

	  Deux conséquences, chacune suffisante :
	    • sécurité — un réseau hostile peut rediriger l'app vers du HTTP et lire les
	      jetons de session en clair ;
	    • publication — Apple exige une JUSTIFICATION écrite pour NSAllowsArbitraryLoads.
	      Sans elle, c'est un motif de rejet.

	  L'application ne parle qu'en HTTPS : cette clé ne servait plus qu'à affaiblir iOS.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>HbaExpress</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Utilisez Face ID pour vous connecter rapidement et en sécurité à HBA Express.</string>
	<!-- Permissions OBLIGATOIRES pour les pièces jointes de la messagerie
	     (image_picker) : sans elles, iOS TUE le processus à l'ouverture de la
	     galerie ou de l'appareil photo. Le texte est affiché à l'utilisateur. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>HBA Express accède à vos photos pour joindre une image à vos messages avec le vendeur.</string>
	<key>NSCameraUsageDescription</key>
	<string>HBA Express utilise l’appareil photo pour joindre une photo à vos messages avec le vendeur.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Votre position sert uniquement à préciser le lieu de livraison pour le coursier. Elle est facultative : vous pouvez commander sans la partager.</string>
	<!-- ─────────────────────────────────────────────────────────────────────────
	     POURQUOI CETTE SECONDE CLÉ, ALORS QUE L'APPLICATION NE DEMANDE JAMAIS
	     L'AUTORISATION « TOUJOURS ».

	     App Store Connect refuse l'envoi (90683) si le binaire RÉFÉRENCE une API
	     sans en déclarer le motif — même si cette API n'est jamais appelée. Le
	     greffon `geolocator` embarque `requestAlwaysAuthorization` dans son code
	     iOS ; l'analyse statique d'Apple la voit, et réclame la clé.

	     Le texte est volontairement IDENTIQUE au motif « pendant l'utilisation » :
	     l'usage est le même, et il n'y a aucun relevé en arrière-plan. Promettre
	     autre chose ici serait faux, et le système ne présentera de toute façon
	     jamais cette demande — l'application n'appelle que
	     `requestWhenInUseAuthorization`.
	     ───────────────────────────────────────────────────────────────────────── -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Votre position sert uniquement à préciser le lieu de livraison pour le coursier. Elle est facultative : vous pouvez commander sans la partager. Elle n'est jamais relevée en arrière-plan.</string>
</dict>
</plist>
