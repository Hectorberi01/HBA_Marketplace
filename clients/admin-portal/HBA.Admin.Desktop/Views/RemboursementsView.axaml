<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             x:Class="HBA.Admin.Desktop.Views.RemboursementsView"
             x:DataType="vm:RemboursementsViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Retours et remboursements" Classes="titre" />
          <TextBlock Classes="attenue" Text="{Binding Position}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <Button Classes="discret" Content="Précédente" Command="{Binding Precedente}" />
          <Button Classes="discret" Content="Suivante" Command="{Binding Suivante}" />
          <Button Classes="discret" Content="Actualiser" Command="{Binding Rafraichir}" />
        </StackPanel>
      </Grid>

      <!--
        LES ONGLETS SONT CEUX QUI ONT DES DOSSIERS, PLUS L'ACTIF.

        Seize états : les afficher tous ferait une barre dont quatorze entrées
        diraient « 0 ». L'onglet actif reste visible même vidé, sinon le filtre
        disparaît sous la main de celui qui vient de traiter le dernier dossier.
      -->
      <ItemsControl ItemsSource="{Binding Facettes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:LigneFacette">
            <Button Classes="discret" Classes.actif="{Binding Actif}"
                    Content="{Binding Libelle}" Margin="0,0,10,10"
                    Command="{Binding $parent[ItemsControl].((vm:RemboursementsViewModel)DataContext).Filtrer}"
                    CommandParameter="{Binding Cle}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding AConfirmation}">
        <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" Foreground="{DynamicResource Succes}" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,400">

      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <ListBox ItemsSource="{Binding Dossiers}" SelectedItem="{Binding Selection}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LigneDossier">
              <Grid ColumnDefinitions="*,Auto" Margin="6">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding Numero}" FontWeight="SemiBold"
                             FontFamily="Consolas,Menlo,monospace" />
                  <TextBlock Text="{Binding Contenu}" Classes="attenue" FontSize="11"
                             TextWrapping="Wrap" MaxWidth="520" />
                  <TextBlock Text="{Binding Ouvert}" Classes="attenue" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Estime}" FontWeight="SemiBold"
                             HorizontalAlignment="Right" />

                  <!-- ManualReview est le seul état qui attend explicitement
                       quelqu'un : il se distingue des quinze autres. -->
                  <Border Classes="pastille" IsVisible="{Binding Arbitrage}"
                          HorizontalAlignment="Right">
                    <TextBlock Text="arbitrage" FontSize="10"
                               Foreground="{DynamicResource Danger}" />
                  </Border>

                  <Border Classes="pastille" IsVisible="{Binding !Arbitrage}"
                          HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Etat}" FontSize="10" />
                  </Border>

                  <Border Classes="pastille" IsVisible="{Binding Depasse}"
                          HorizontalAlignment="Right">
                    <TextBlock Text="échéance dépassée" FontSize="10"
                               Foreground="{DynamicResource Alerte}" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0">
        <ScrollViewer>
          <StackPanel Spacing="14">

            <TextBlock Classes="attenue" TextWrapping="Wrap"
                       IsVisible="{Binding !ADesSelection}"
                       Text="Sélectionnez un dossier." />

            <StackPanel Spacing="14" IsVisible="{Binding ADesSelection}">

              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Selection.Numero}" Classes="titre" FontSize="18"
                           FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Text="{Binding Selection.Etat}" Classes="attenue" FontSize="12" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Remboursement estimé" Classes="attenue" FontSize="11" />
                <TextBlock Text="{Binding Selection.Estime}" Classes="chiffre" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Remboursement accordé" Classes="attenue" FontSize="11" />
                <TextBlock Text="{Binding Selection.Accorde}" FontWeight="SemiBold" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Contenu" Classes="attenue" FontSize="11" />
                <TextBlock Text="{Binding Selection.Contenu}" TextWrapping="Wrap" FontSize="13" />
                <TextBlock Text="{Binding Selection.Transport}" Classes="attenue" FontSize="11" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Ouvert le · échéance" Classes="attenue" FontSize="11" />
                <TextBlock FontSize="13" Text="{Binding Selection.Ouvert}" />
                <TextBlock FontSize="13" Text="{Binding Selection.Echeance}" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Commande · client · vendeur" Classes="attenue" FontSize="11" />
                <TextBlock Text="{Binding Selection.Commande}" FontSize="11"
                           FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Text="{Binding Selection.Client}" FontSize="11"
                           FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Text="{Binding Selection.Vendeur}" FontSize="11"
                           FontFamily="Consolas,Menlo,monospace" />
              </StackPanel>

              <!--
                LE NOM DE LA ROUTE N'EST PAS LE NOM DU GESTE.

                `POST /{id}/override` envoie `RejectReturnCommand`. « Arbitrer »
                ou « passer outre » laisserait croire à un déblocage : le bouton
                dit ce qui se passe.
              -->
              <Border Classes="creux" Padding="16,12">
                <TextBlock Text="{Binding Avertissement}" TextWrapping="Wrap"
                           Classes="attenue" FontSize="11" />
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="danger" Content="Rejeter le dossier" Command="{Binding Rejeter}" />
                <Button Classes="discret" Content="Clore" Command="{Binding Clore}" />
              </StackPanel>

            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>

  </DockPanel>
</UserControl>
