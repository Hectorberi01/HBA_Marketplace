<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             xmlns:svc="clr-namespace:HBA.Admin.Desktop.Services"
             x:Class="HBA.Admin.Desktop.Views.VendeursView"
             x:DataType="vm:VendeursViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <StackPanel Spacing="2">
        <TextBlock Text="Gouvernance des vendeurs" Classes="titre" />
        <TextBlock Classes="attenue" Text="{Binding Position}" />
      </StackPanel>

      <Grid ColumnDefinitions="*,170,190,Auto" >
        <Border Grid.Column="0" Classes="creux" Margin="0,0,10,0">
          <TextBox Text="{Binding Recherche}" Watermark="Nom de boutique" />
        </Border>

        <ComboBox Grid.Column="1"
                  Margin="0,0,10,0"
                  MinHeight="44"
                  ItemsSource="{Binding StatutsKyb}"
                  SelectedItem="{Binding FiltreKyb}"
                  PlaceholderText="Dossier KYB" />

        <ComboBox Grid.Column="2"
                  Margin="0,0,10,0"
                  MinHeight="44"
                  ItemsSource="{Binding Statuts}"
                  SelectedItem="{Binding FiltreStatut}"
                  PlaceholderText="Statut du compte" />

        <Button Grid.Column="3" Classes="principal" Content="Chercher" Command="{Binding Chercher}" />
      </Grid>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Danger}" />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding AConfirmation}">
        <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Succes}" />
      </Border>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="4,14,4,0">
      <Button Grid.Column="0" Classes="discret" Content="Précédente" Command="{Binding Precedente}" />
      <Button Grid.Column="2" Classes="discret" Content="Suivante" Command="{Binding Suivante}" />
    </Grid>

    <Grid ColumnDefinitions="*,400">

      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <ListBox ItemsSource="{Binding Vendeurs}"
                 SelectedItem="{Binding Selection}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="svc:VendeurAdmin">
              <Grid ColumnDefinitions="*,120,120" Margin="6">
                <TextBlock Grid.Column="0" Text="{Binding ShopName}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding KybStatus}" Classes="attenue" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="attenue" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0">
        <DockPanel>

          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Décisions" Classes="titre" FontSize="18" />

            <!-- Sans sélection, le panneau dit pourquoi il est inerte. Des
                 boutons grisés sans explication font cliquer trois fois. -->
            <TextBlock Classes="attenue"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !ADesSelection}"
                       Text="Sélectionnez un vendeur dans la liste." />

            <TextBlock Classes="attenue"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ADesSelection}"
                       Text="{Binding Selection.ShopName}" />
          </StackPanel>

          <ScrollViewer>
            <StackPanel Spacing="14">

              <ItemsControl ItemsSource="{Binding Gestes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="svc:GesteVendeur">

                    <!--
                      LE BOUTON EST ROUGE QUAND LE GESTE EST DESTRUCTEUR, ET LA
                      TABLE LE DIT — pas le gabarit. Ajouter un geste destructeur
                      sans toucher à ce fichier lui donnera donc la bonne couleur
                      ET la ré-authentification, ou aucune des deux : les deux
                      propriétés viennent de la même source.
                    -->
                    <Button Classes="discret"
                            Classes.danger="{Binding Destructeur}"
                            Content="{Binding Libelle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Command="{Binding $parent[ItemsControl].((vm:VendeursViewModel)DataContext).Agir}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!--
                ═══════════════════════════════════════════════════════════════
                LES BOUTIQUES DU VENDEUR — CE QUE LES GESTES CI-DESSUS NE FONT
                   PAS.

                Les décisions du haut portent sur le VENDEUR : suspendre, lever,
                approuver un KYB. Un vendeur peut tenir plusieurs boutiques, et
                jusqu'ici la seule sanction possible fermait les trois pour ce
                qu'une seule avait fait.
                ═══════════════════════════════════════════════════════════════
              -->
              <Border Height="1" Background="{DynamicResource AccentDoux}"
                      IsVisible="{Binding ADesSelection}" />

              <StackPanel Spacing="10" IsVisible="{Binding ADesSelection}">

                <StackPanel Spacing="2">
                  <TextBlock Text="Boutiques" Classes="titre" FontSize="16" />
                  <TextBlock Text="{Binding PositionBoutiques}" Classes="attenue" FontSize="11" />
                </StackPanel>

                <TextBlock Classes="attenue" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding AErreurBoutiques}"
                           Foreground="{DynamicResource Danger}"
                           Text="{Binding ErreurBoutiques}" />

                <ListBox ItemsSource="{Binding Boutiques}"
                         SelectedItem="{Binding SelectionBoutique}"
                         Background="Transparent" BorderThickness="0"
                         MaxHeight="260">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:LigneBoutique">
                      <StackPanel Spacing="2" Margin="6">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Nom}" FontWeight="SemiBold" />

                          <Border Grid.Column="1" Classes="pastille"
                                  IsVisible="{Binding Suspendue}" VerticalAlignment="Center">
                            <TextBlock Text="suspendue" FontSize="10"
                                       Foreground="{DynamicResource Danger}" />
                          </Border>
                        </Grid>

                        <TextBlock Text="{Binding Etat}" Classes="attenue" FontSize="11" />

                        <!-- « Ouverte » et « en vente » ne sont pas la même
                             chose : une boutique ouverte hors de ses horaires ne
                             vend pas non plus. -->
                        <TextBlock Text="{Binding Vente}" Classes="attenue" FontSize="11" />

                        <TextBlock Text="{Binding Motif}" Classes="attenue" FontSize="11"
                                   TextWrapping="Wrap" IsVisible="{Binding AMotif}" />

                        <!-- Sans lieu d'expédition, rien ne peut être enlevé
                             chez elle. Ça ne se voit pas depuis la fiche
                             vendeur. -->
                        <TextBlock Text="aucun lieu d'expédition rattaché"
                                   FontSize="11" IsVisible="{Binding SansLieu}"
                                   Foreground="{DynamicResource Alerte}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Spacing="10"
                            IsVisible="{Binding ADesBoutique}">
                  <Button Classes="danger" Content="Suspendre" Command="{Binding Suspendre}" />
                  <Button Classes="discret" Content="Lever" Command="{Binding Lever}" />
                </StackPanel>

                <TextBlock Classes="attenue" FontSize="11" TextWrapping="Wrap"
                           Text="Suspendre n'est pas fermer : une boutique « fermée » l'a été par son vendeur — congés, travaux — et il la rouvre quand il veut. Une boutique suspendue l'a été par la plateforme, et lui seul ne peut pas la rouvrir. C'est pourquoi « Lever » ne s'offre que sur une suspension." />

              </StackPanel>

            </StackPanel>
          </ScrollViewer>

        </DockPanel>
      </Border>

    </Grid>

  </DockPanel>

</UserControl>
