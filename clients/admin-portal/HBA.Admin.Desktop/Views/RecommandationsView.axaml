<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             x:Class="HBA.Admin.Desktop.Views.RecommandationsView"
             x:DataType="vm:RecommandationsViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Recommandations" Classes="titre" />
          <TextBlock Classes="attenue" Text="{Binding Position}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <Button Classes="discret" Content="Précédente" Command="{Binding Precedente}" />
          <Button Classes="discret" Content="Suivante" Command="{Binding Suivante}" />
          <Button Classes="discret" Content="Actualiser" Command="{Binding Rafraichir}" />
          <Button Classes="principal" Content="Nouvelle" Command="{Binding Nouvelle}" />
        </StackPanel>
      </Grid>

      <ItemsControl ItemsSource="{Binding Facettes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:LigneFacette">
            <Button Classes="discret" Classes.actif="{Binding Actif}"
                    Content="{Binding Libelle}" Margin="0,0,10,10"
                    Command="{Binding $parent[ItemsControl].((vm:RecommandationsViewModel)DataContext).Filtrer}"
                    CommandParameter="{Binding Cle}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!--
        CET ÉCRAN ÉCRIT LA PAGE D'ACCUEIL, ET IL FAUT LE DIRE EN HAUT.

        La route d'écriture acceptait autrefois la commande brute de n'importe
        quel inscrit : on choisissait les produits mis en avant sur la fiche
        d'un concurrent. Elle est passée sur le groupe admin — mais le pouvoir,
        lui, n'a pas changé de nature.

        CE QUE CE BANDEAU NE COUVRE PAS : le calcul automatique. Rien ici ne dit
        si un moteur repassera derrière et remplacera ce qui vient d'être écrit ;
        aucune colonne ne distingue une ligne posée à la main d'une ligne
        calculée. Le domaine ne garde pas cette information.
      -->
      <Border Classes="creux" Padding="16,12">
        <TextBlock TextWrapping="Wrap" Classes="attenue" FontSize="12"
                   Text="Ces listes sont ce que la plateforme met en avant : produits liés sur une fiche, suggestions personnalisées à l'accueil. Rien ne distingue une ligne écrite ici d'une ligne calculée par le moteur — un recalcul la remplacera sans avertir." />
      </Border>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding AConfirmation}">
        <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" Foreground="{DynamicResource Succes}" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,440">

      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <ListBox ItemsSource="{Binding Recommandations}" SelectedItem="{Binding Selection}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LigneRecommandation">
              <Grid ColumnDefinitions="*,Auto" Margin="6">
                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                  <TextBlock Text="{Binding Resume}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Produits}" Classes="attenue" FontSize="11" />
                  <TextBlock Text="{Binding Calcule}" Classes="attenue" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Score}" FontWeight="SemiBold"
                             HorizontalAlignment="Right" />

                  <!--
                    UNE LIGNE SANS CONTEXTE N'EST RETROUVÉE PAR AUCUNE LECTURE.

                    La commande n'exige ni produit ni utilisateur : sans l'un des
                    deux, `existing` reste nul, une ligne est créée, et les trois
                    lectures du service — toutes adressées — passeront à côté
                    pour toujours. Cette liste est le seul endroit d'où on la voit.
                  -->
                  <Border Classes="pastille" IsVisible="{Binding Orpheline}"
                          HorizontalAlignment="Right">
                    <TextBlock Text="sans contexte" FontSize="10"
                               Foreground="{DynamicResource Alerte}" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0">
        <ScrollViewer>
          <StackPanel Spacing="16">

            <TextBlock Classes="attenue" TextWrapping="Wrap"
                       IsVisible="{Binding !EnEdition}"
                       Text="Sélectionnez une recommandation pour revoir sa liste, ou créez-en une. Les identifiants de produit se copient depuis l'écran Produits." />

            <StackPanel Spacing="14" IsVisible="{Binding EnEdition}">

              <TextBlock Text="{Binding Titre}" Classes="titre" FontSize="18" />

              <!--
                L'ENREGISTREMENT REMPLACE, ET C'EST LA PHRASE LA PLUS IMPORTANTE
                DE L'ÉCRAN.

                `UpsertRecommendationCommandHandler` cherche l'existant sur la
                clé (type + contexte) et appelle `Refresh`, qui réécrit la liste
                ENTIÈRE et le score. Envoyer un produit sur une clé qui en
                portait dix en efface neuf — sans confirmation côté serveur, et
                avec le même 201 que pour une création.
              -->
              <Border Classes="creux" Padding="16,12">
                <TextBlock Text="{Binding Consigne}" TextWrapping="Wrap"
                           Classes="attenue" FontSize="11" />
              </Border>

              <!--
                PAS DE `ColumnSpacing` SUR `Grid` DANS AVALONIA 11.2 : la
                propriété n'existe qu'en WPF et en WinUI, et son emploi échoue à
                la COMPILATION (AVLN2000). Marge droite sur toutes les colonnes
                sauf la dernière.
              -->
              <Grid ColumnDefinitions="220,*">
                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,10,0">
                  <TextBlock Text="Type" Classes="attenue" FontSize="12" />
                  <ComboBox MinHeight="44" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Types}"
                            SelectedItem="{Binding TypeSaisi}"
                            IsEnabled="{Binding CleModifiable}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="Score" Classes="attenue" FontSize="12" />
                  <Border Classes="creux"><TextBox Text="{Binding Score}" Watermark="1" /></Border>
                </StackPanel>
              </Grid>

              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LibelleContexte}" Classes="attenue" FontSize="12" />
                <Border Classes="creux">
                  <TextBox Text="{Binding Contexte}" IsEnabled="{Binding CleModifiable}"
                           Watermark="identifiant" />
                </Border>
              </StackPanel>

              <TextBlock Classes="attenue" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding !CleModifiable}"
                         Text="Type et contexte sont figés hors création — non par contrainte du serveur, mais parce que les changer écrirait une AUTRE recommandation et laisserait celle-ci intacte." />

              <StackPanel Spacing="8">
                <TextBlock Text="Produits mis en avant, un identifiant par ligne"
                           Classes="attenue" FontSize="12" />
                <Border Classes="creux">
                  <TextBox Text="{Binding Produits}" AcceptsReturn="True" MinHeight="140"
                           TextWrapping="NoWrap" FontFamily="Consolas,Menlo,monospace"
                           FontSize="11" Watermark="un identifiant par ligne" />
                </Border>
                <TextBlock Text="{Binding CompteSaisi}" Classes="attenue" FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="principal" Content="Enregistrer" Command="{Binding Enregistrer}" />
                <Button Classes="discret" Content="Abandonner" Command="{Binding Abandonner}" />
              </StackPanel>

              <!--
                NI SUPPRESSION NI DÉSACTIVATION : LE SERVICE N'EN A PAS.

                Le dépôt n'expose qu'`AddAsync` et deux lectures ; aucune route
                ne retire une recommandation. Vider la liste des produits n'est
                pas une échappatoire — le domaine refuse une liste vide côté
                écran, et une liste vide côté serveur laisserait une ligne
                fantôme. Retirer une mise en avant demande aujourd'hui d'agir en
                base.
              -->
              <TextBlock Classes="attenue" FontSize="11" TextWrapping="Wrap"
                         Text="Aucune route ne supprime une recommandation : le service n'expose que l'écriture et deux lectures adressées. Une clé posée ici reste posée jusqu'au prochain remplacement." />

            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>

  </DockPanel>
</UserControl>
