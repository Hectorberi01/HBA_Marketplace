<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             x:Class="HBA.Admin.Desktop.Views.ModerationAvisView"
             x:DataType="vm:ModerationAvisViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Modération des avis" Classes="titre" />
          <TextBlock Classes="attenue" Text="{Binding Position}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <Button Classes="discret" Content="Précédente" Command="{Binding Precedente}" />
          <Button Classes="discret" Content="Suivante" Command="{Binding Suivante}" />
          <Button Classes="discret" Content="Actualiser" Command="{Binding Rafraichir}" />
        </StackPanel>
      </Grid>

      <ItemsControl ItemsSource="{Binding Facettes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:LigneFacette">
            <Button Classes="discret" Classes.actif="{Binding Actif}"
                    Content="{Binding Libelle}"
                    Command="{Binding $parent[ItemsControl].((vm:ModerationAvisViewModel)DataContext).Filtrer}"
                    CommandParameter="{Binding Cle}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Ce que le domaine ne stocke pas : qui a signalé, et pourquoi. -->
      <Border Classes="creux" Padding="16,12">
        <TextBlock Text="{Binding Limite}" TextWrapping="Wrap" Classes="attenue" FontSize="12" />
      </Border>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding AConfirmation}">
        <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" Foreground="{DynamicResource Succes}" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,400">

      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <ListBox ItemsSource="{Binding Avis}" SelectedItem="{Binding Selection}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LigneAvis">
              <Grid ColumnDefinitions="*,Auto" Margin="6">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Corps}" Classes="attenue" FontSize="11"
                             TextWrapping="Wrap" MaxLines="2" MaxWidth="560" />
                  <TextBlock Text="{Binding Depose}" Classes="attenue" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Note}" HorizontalAlignment="Right" />

                  <Border Classes="pastille" IsVisible="{Binding !EstPublie}"
                          HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Etat}" FontSize="10" />
                  </Border>

                  <!-- Un avis sans achat vérifié est celui qu'on relit d'abord :
                       c'est là que se logent les faux. -->
                  <Border Classes="pastille" IsVisible="{Binding SansAchat}"
                          HorizontalAlignment="Right">
                    <TextBlock Text="achat non vérifié" FontSize="10"
                               Foreground="{DynamicResource Alerte}" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0">
        <ScrollViewer>
          <StackPanel Spacing="14">

            <TextBlock Classes="attenue" TextWrapping="Wrap"
                       IsVisible="{Binding !ADesSelection}"
                       Text="Sélectionnez un avis." />

            <StackPanel Spacing="14" IsVisible="{Binding ADesSelection}">

              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Selection.Titre}" Classes="titre" FontSize="18"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Selection.Note}" FontSize="16" />
                <TextBlock Text="{Binding Selection.Etat}" Classes="attenue" FontSize="12" />
              </StackPanel>

              <Border Classes="creux" Padding="16,14">
                <TextBlock Text="{Binding Selection.Corps}" TextWrapping="Wrap" FontSize="13" />
              </Border>

              <StackPanel Spacing="4" IsVisible="{Binding Selection.ARepondu}">
                <TextBlock Text="Réponse du vendeur" Classes="attenue" FontSize="11" />
                <Border Classes="creux" Padding="16,14">
                  <TextBlock Text="{Binding Selection.Reponse}" TextWrapping="Wrap" FontSize="13" />
                </Border>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Produit · vendeur" Classes="attenue" FontSize="11" />
                <TextBlock Text="{Binding Selection.Produit}" FontSize="11"
                           FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Text="{Binding Selection.Vendeur}" FontSize="11"
                           FontFamily="Consolas,Menlo,monospace" />
              </StackPanel>

              <!--
                REJETER ET RESTAURER CHANGENT UNE MOYENNE AFFICHÉE.

                La note d'un produit et celle d'un vendeur ne comptent que les avis
                publiés. Signaler, en revanche, ne retire rien de la vitrine : c'est
                une mise de côté, et c'est pourquoi ce geste-là ne demande pas de
                mot de passe.
              -->
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="discret" Content="Signaler" Command="{Binding Signaler}" />
                <Button Classes="danger" Content="Rejeter" Command="{Binding Rejeter}" />
                <Button Classes="principal" Content="Restaurer" Command="{Binding Restaurer}" />
              </StackPanel>

              <TextBlock Classes="attenue" FontSize="11" TextWrapping="Wrap"
                         Text="Signaler met de côté sans effet sur la note. Rejeter sort l'avis de la moyenne du produit et de celle du vendeur ; restaurer l'y remet." />

            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>

  </DockPanel>
</UserControl>
