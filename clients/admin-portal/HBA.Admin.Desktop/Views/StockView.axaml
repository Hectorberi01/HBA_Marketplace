<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             x:Class="HBA.Admin.Desktop.Views.StockView"
             x:DataType="vm:StockViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Stock" Classes="titre" />
          <TextBlock Classes="attenue" Text="{Binding Position}" />
        </StackPanel>

        <ComboBox Grid.Column="1" MinHeight="44" Margin="0,0,10,0"
                  ItemsSource="{Binding Volumes}" SelectedItem="{Binding Combien}" />

        <Button Grid.Column="2" Classes="discret" Content="Actualiser"
                Command="{Binding Rafraichir}" VerticalAlignment="Center" />
      </Grid>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <Border Classes="creux" Padding="16,12">
        <TextBlock Text="{Binding Plafond}" TextWrapping="Wrap" Classes="attenue" FontSize="12" />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,360">

      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="creux" Margin="6,4,6,8">
            <TextBox Text="{Binding Recherche}" Watermark="Rechercher un SKU ou un lieu" />
          </Border>

          <ListBox ItemsSource="{Binding Articles}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:LigneArticle">
                <Grid ColumnDefinitions="*,Auto" Margin="6">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Sku}" FontWeight="SemiBold"
                               FontFamily="Consolas,Menlo,monospace" />
                    <TextBlock Text="{Binding Detail}" Classes="attenue" FontSize="11" />
                    <TextBlock Text="{Binding Lieu}" Classes="attenue" FontSize="11" />
                    <TextBlock Text="{Binding Contact}" Classes="attenue" FontSize="11"
                               IsVisible="{Binding AContact}" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <!-- Zéro vendable : c'est la seule ligne qui coûte une vente
                         maintenant, et elle doit se voir avant les autres. -->
                    <Border Classes="pastille" IsVisible="{Binding EnRupture}">
                      <TextBlock Text="rupture" FontSize="10"
                                 Foreground="{DynamicResource Danger}" />
                    </Border>

                    <!-- Du physique existe mais il est réservé : ce n'est pas un
                         réapprovisionnement qu'il faut, c'est une commande à
                         régler. -->
                    <Border Classes="pastille" IsVisible="{Binding SousReserve}">
                      <TextBlock Text="réservé" FontSize="10"
                                 Foreground="{DynamicResource Alerte}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0" Padding="8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="6,4,6,8">
            <TextBlock Text="Lieux d'expédition" Classes="groupe" />
            <TextBlock Text="{Binding PositionLieux}" Classes="attenue" FontSize="11" />
          </StackPanel>

          <ListBox ItemsSource="{Binding Lieux}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:LigneLieu">
                <StackPanel Spacing="2" Margin="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Libelle}" FontWeight="SemiBold" />
                    <Border Grid.Column="1" Classes="pastille" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Nature}" FontSize="10" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Adresse}" Classes="attenue" FontSize="11" />
                  <TextBlock Text="{Binding Contact}" Classes="attenue" FontSize="11"
                             IsVisible="{Binding AContact}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

    </Grid>

  </DockPanel>
</UserControl>
