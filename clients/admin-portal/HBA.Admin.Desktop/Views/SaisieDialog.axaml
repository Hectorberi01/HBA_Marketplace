<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HBA.Admin.Desktop.Views.SaisieDialog"
        Title="Confirmation"
        Width="440" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Border Classes="eleve" Margin="16">
    <StackPanel Spacing="14">

      <TextBlock Name="Titre" Classes="titre" TextWrapping="Wrap" />
      <TextBlock Name="Invite" Classes="attenue" TextWrapping="Wrap" />

      <Border Classes="creux">
        <TextBox Name="Saisie" AcceptsReturn="False" />
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="discret" Content="Annuler" Click="SurAnnuler" IsCancel="True" />
        <Button Classes="principal" Content="Confirmer" Click="SurConfirmer" IsDefault="True" />
      </StackPanel>

    </StackPanel>
  </Border>

</Window>
