<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             x:Class="HBA.Admin.Desktop.Views.AccueilView"
             x:DataType="vm:AccueilViewModel">

  <DockPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,4,14">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="Files d'attente" Classes="titre" />
        <TextBlock Classes="attenue"
                   Text="Ce qui attend une décision, tous services confondus." />
      </StackPanel>

      <Button Grid.Column="1"
              Classes="discret"
              Content="Actualiser"
              Command="{Binding Rafraichir}"
              VerticalAlignment="Center" />
    </Grid>

    <ProgressBar DockPanel.Dock="Top"
                 IsIndeterminate="True"
                 IsVisible="{Binding EnCours}"
                 Height="3"
                 Margin="4,0,4,10" />

    <Border DockPanel.Dock="Top"
            Classes="carte"
            IsVisible="{Binding EnErreur}"
            Margin="4,0,4,12"
            Padding="16,12">
      <TextBlock Text="{Binding Erreur}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource Danger}" />
    </Border>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Files}" Margin="4">

        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:TuileFile">
            <Border Classes="carte" Width="260" Height="150" Margin="0,0,16,16">
              <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding Libelle}"
                           Classes="attenue"
                           TextWrapping="Wrap" />

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding Note}"
                           Classes="attenue"
                           FontSize="12" />

                <!--
                  LA COULEUR CHANGE QUAND LE CHIFFRE EST INCONNU.

                  Un « — » gris se distingue d'un compte à zéro au premier
                  coup d'œil. Le même noir pour les deux rendrait l'absence de
                  donnée indiscernable d'une file vide — c'est exactement ce que
                  le BFF prend soin de distinguer en rendant `null` plutôt que 0.
                -->
                <TextBlock Text="{Binding Valeur}"
                           Classes="chiffre"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}" />

              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>

      </ItemsControl>
    </ScrollViewer>

  </DockPanel>

</UserControl>
