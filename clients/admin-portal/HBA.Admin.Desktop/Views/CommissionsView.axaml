<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             x:Class="HBA.Admin.Desktop.Views.CommissionsView"
             x:DataType="vm:CommissionsViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Commissions" Classes="titre" />
          <TextBlock Classes="attenue" Text="{Binding Position}" />
        </StackPanel>

        <Button Grid.Column="1" Classes="discret" Content="Actualiser" Margin="0,0,10,0"
                Command="{Binding Rafraichir}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="principal" Content="Nouvelle règle"
                Command="{Binding Nouvelle}" VerticalAlignment="Center" />
      </Grid>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <!--
        CE BANDEAU DIT CE QUE LA LISTE SEULE NE PEUT PAS DIRE.

        Deux choses, et elles ne se lisent nulle part ailleurs dans l'écran :

        1. L'ORDRE D'AFFICHAGE EST L'ORDRE D'APPLICATION. `CommissionResolver`
           classe par `Priority => (int)Scope` — vendeur, puis catégorie, puis
           global — et départage par prise d'effet décroissante. La liste est
           triée pareil ; la première ligne qui correspond est celle qui prélève.

        2. QUAND AUCUNE RÈGLE NE CORRESPOND, LE MOTEUR NE PRÉLÈVE PAS ZÉRO. Il
           applique le taux par défaut de la plateforme. C'est pourquoi l'aperçu
           ci-contre passe par la route `compute` du serveur plutôt que de
           recalculer ici : un calcul recopié avait déjà annoncé « commission :
           0 » pendant que la comptabilisation prélevait sa part.

        CE QUE CE BANDEAU NE COUVRE PAS : la grille par défaut elle-même n'est
        pas réglable depuis cette console — elle vit dans la configuration du
        service financier.
      -->
      <Border Classes="creux" Padding="16,12">
        <TextBlock TextWrapping="Wrap" Classes="attenue" FontSize="12"
                   Text="Les règles sont listées dans l'ordre où le moteur les examine : vendeur, puis catégorie, puis plateforme entière ; à portée égale, la prise d'effet la plus récente d'abord. Si aucune ne correspond, le moteur applique le taux par défaut de la plateforme — jamais zéro." />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding AConfirmation}">
        <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" Foreground="{DynamicResource Succes}" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="400,*">

      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <ListBox ItemsSource="{Binding Regles}" SelectedItem="{Binding Selection}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LigneCommission">
              <StackPanel Spacing="3" Margin="6">

                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Resume}" FontWeight="SemiBold"
                             Margin="0,0,10,0" />

                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <!--
                      « ACTIVE » ET « EN VIGUEUR » NE SONT PAS LA MÊME CHOSE.

                      `IsApplicableAt` exige `IsActive && EffectiveFromUtc <= now` :
                      une règle programmée pour la semaine prochaine est active et
                      ne prélève rien. Le seul drapeau ne le distingue pas, donc
                      la pastille porte l'état calculé, pas le booléen.
                    -->
                    <Border Classes="pastille" IsVisible="{Binding EnVigueur}">
                      <TextBlock Text="en vigueur" FontSize="10"
                                 Foreground="{DynamicResource Succes}" />
                    </Border>

                    <Border Classes="pastille" IsVisible="{Binding Programmee}">
                      <TextBlock Text="programmée" FontSize="10"
                                 Foreground="{DynamicResource Alerte}" />
                    </Border>

                    <Border Classes="pastille" IsVisible="{Binding !Active}">
                      <TextBlock Text="désactivée" FontSize="10" />
                    </Border>
                  </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Tarif}" FontSize="12" />

                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Bornes}" Classes="attenue"
                             FontSize="11" Margin="0,0,10,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Effet}" Classes="attenue"
                             FontSize="11" />
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0">
        <ScrollViewer>
          <StackPanel Spacing="16">

            <!--
              L'APERÇU RESTE VISIBLE SANS SÉLECTION, ET C'EST VOULU.

              Il ne dépend d'aucune règle choisie : il demande au serveur ce qui
              serait prélevé pour un vendeur et une catégorie donnés. C'est la
              seule façon de savoir laquelle des règles gagne réellement.
            -->
            <StackPanel Spacing="10">
              <TextBlock Text="Aperçu du prélèvement" Classes="titre" FontSize="16" />

              <TextBlock Classes="attenue" FontSize="11" TextWrapping="Wrap"
                         Text="Le calcul est fait par le moteur du service financier, pas recopié ici. Les deux identifiants se copient depuis les écrans Vendeurs et Catégories." />

              <Border Classes="creux" Padding="16,14">
                <StackPanel Spacing="10">

                  <!--
                    PAS DE `ColumnSpacing` SUR `Grid` DANS AVALONIA 11.2 : la
                    propriété n'existe qu'en WPF et en WinUI, et son emploi ici
                    échoue à la COMPILATION (AVLN2000). On écarte par une marge
                    droite sur toutes les colonnes sauf la dernière.
                  -->
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="Vendeur" Classes="attenue" Width="80"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Grid.Column="1" Classes="creux">
                      <TextBox Text="{Binding VendeurEssai}" Watermark="identifiant du vendeur" />
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="Catégorie" Classes="attenue" Width="80"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Grid.Column="1" Classes="creux">
                      <TextBox Text="{Binding CategorieEssai}" Watermark="identifiant de la catégorie" />
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="Auto,140,Auto">
                    <TextBlock Grid.Column="0" Text="Montant" Classes="attenue" Width="80"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Grid.Column="1" Classes="creux" Margin="0,0,10,0">
                      <TextBox Text="{Binding MontantEssai}" Watermark="brut" />
                    </Border>
                    <Button Grid.Column="2" Classes="discret" Content="Calculer"
                            Command="{Binding Calculer}" VerticalAlignment="Center" />
                  </Grid>

                  <TextBlock Text="{Binding Apercu}" Classes="chiffre"
                             IsVisible="{Binding AApercu}" />

                  <TextBlock Text="{Binding ApercuRegle}" Classes="attenue" FontSize="11"
                             TextWrapping="Wrap" IsVisible="{Binding AApercu}" />

                  <TextBlock Text="{Binding ErreurApercu}" TextWrapping="Wrap" FontSize="11"
                             IsVisible="{Binding AErreurApercu}"
                             Foreground="{DynamicResource Danger}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource TexteAttenue}" Opacity="0.2" />

            <TextBlock Classes="attenue" TextWrapping="Wrap"
                       IsVisible="{Binding !EnEdition}"
                       Text="Sélectionnez une règle pour la modifier, ou créez-en une. Une règle naît active : si sa prise d'effet est passée, elle prélève dès l'enregistrement." />

            <StackPanel Spacing="14" IsVisible="{Binding EnEdition}">

              <TextBlock Text="{Binding Titre}" Classes="titre" FontSize="18" />

              <!--
                LE PÉRIMÈTRE NE SE MODIFIE QU'À LA CRÉATION.

                `UpdateCommissionRuleCommand` ne reprend ni `Scope` ni `TargetId` —
                le domaine le dit en toutes lettres. Laisser les deux champs
                actifs ferait croire à une modification qui ne partirait jamais,
                sans erreur pour le signaler.
              -->
              <Grid ColumnDefinitions="200,*">
                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,10,0">
                  <TextBlock Text="Portée" Classes="attenue" FontSize="12" />
                  <ComboBox MinHeight="44" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Portees}"
                            SelectedItem="{Binding Portee}"
                            IsEnabled="{Binding PorteeModifiable}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8" IsVisible="{Binding CibleRequise}">
                  <TextBlock Text="Identifiant visé" Classes="attenue" FontSize="12" />
                  <Border Classes="creux">
                    <TextBox Text="{Binding Cible}" IsEnabled="{Binding PorteeModifiable}"
                             Watermark="vendeur ou catégorie" />
                  </Border>
                </StackPanel>
              </Grid>

              <TextBlock Classes="attenue" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding !PorteeModifiable}"
                         Text="Portée et cible ne se modifient pas après création : la mise à jour ne les transporte pas. Pour changer de périmètre, créez une règle et désactivez celle-ci." />

              <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,10,0">
                  <TextBlock Text="Taux (0 à 1)" Classes="attenue" FontSize="12" />
                  <Border Classes="creux"><TextBox Text="{Binding Taux}" Watermark="0.10" /></Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,10,0">
                  <TextBlock Text="Frais fixes" Classes="attenue" FontSize="12" />
                  <Border Classes="creux"><TextBox Text="{Binding Fixe}" Watermark="0" /></Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Text="Devise" Classes="attenue" FontSize="12" />
                  <Border Classes="creux"><TextBox Text="{Binding Devise}" Watermark="XOF" /></Border>
                </StackPanel>
              </Grid>

              <TextBlock Classes="attenue" FontSize="11" TextWrapping="Wrap"
                         Text="0.10 vaut 10 %. Les frais fixes s'ajoutent au pourcentage, ils ne le remplacent pas." />

              <!--
                MIN SUPÉRIEUR À MAX NE LÈVE PAS : IL PLAFONNE TOUT.

                `ComputeCommission` applique le plancher puis le plafond, sans
                `Math.Clamp`. Un minimum au-dessus du maximum donne donc le
                maximum à chaque fois — un réglage qui ne fait pas ce qu'on
                croit. L'écran le refuse avant l'envoi ; le serveur, lui, l'accepte.
              -->
              <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,10,0">
                  <TextBlock Text="Minimum, vide = aucun" Classes="attenue" FontSize="12" />
                  <Border Classes="creux"><TextBox Text="{Binding Minimum}" /></Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="Maximum, vide = aucun" Classes="attenue" FontSize="12" />
                  <Border Classes="creux"><TextBox Text="{Binding Maximum}" /></Border>
                </StackPanel>
              </Grid>

              <!--
                TOUCHER À LA DATE EST UN GESTE, ET L'ÉCRAN LE DIT AVANT L'ENVOI.

                `EffectiveFromUtc` est nullable côté commande, et `null` signifie
                « ne touche pas à la date ». C'est la correction d'un bogue :
                le champ non nullable était comblé par `?? DateTime.UtcNow`, si
                bien qu'une simple correction de taux rendait une règle
                PROGRAMMÉE applicable sur-le-champ et la faisait passer devant
                ses sœurs de même portée. La date ne part donc que si elle a été
                modifiée ici, et la ligne ci-dessous dit laquelle des deux
                situations s'applique.
              -->
              <StackPanel Spacing="8">
                <TextBlock Text="Prise d'effet (UTC)" Classes="attenue" FontSize="12" />
                <Border Classes="creux">
                  <TextBox Text="{Binding Effet}" Watermark="2026-08-23 00:00" />
                </Border>

                <TextBlock Classes="attenue" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding !DateSeraEnvoyee}"
                           Text="La date ne partira pas : elle reste celle d'origine tant qu'elle n'est pas modifiée ici." />

                <TextBlock FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding DateSeraEnvoyee}"
                           Foreground="{DynamicResource Alerte}"
                           Text="La date partira avec l'enregistrement. Une règle programmée peut ainsi devenir applicable immédiatement et passer devant ses sœurs de même portée." />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="principal" Content="Enregistrer" Command="{Binding Enregistrer}" />
                <Button Classes="discret" Content="Activer" Command="{Binding Activer}" />
                <Button Classes="discret" Content="Désactiver" Command="{Binding Desactiver}" />
                <Button Classes="danger" Content="Supprimer" Command="{Binding Supprimer}" />
              </StackPanel>

              <TextBlock Classes="attenue" FontSize="11" TextWrapping="Wrap"
                         Text="Enregistrer ne change pas l'état : activation et désactivation sont des gestes distincts. Supprimer efface la règle ; désactiver la garde lisible et réactivable — c'est presque toujours le bon geste sur une grille passée." />

            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>

  </DockPanel>
</UserControl>
