<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             x:Class="HBA.Admin.Desktop.Views.PortefeuilleView"
             x:DataType="vm:PortefeuilleViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Portefeuilles" Classes="titre" />
          <TextBlock Classes="attenue" Text="{Binding Position}" />
        </StackPanel>

        <ComboBox Grid.Column="1" MinHeight="44" Margin="0,0,10,0"
                  ItemsSource="{Binding Volumes}" SelectedItem="{Binding Combien}" />

        <Button Grid.Column="2" Classes="discret" Content="Actualiser"
                Command="{Binding Rafraichir}" VerticalAlignment="Center" />
      </Grid>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <!--
        QUATRE POCHES, PAS UN TOTAL.

        Commissions est un revenu, frais opérateur une dépense, livraison un
        encaissement, remboursements une sortie. Un chiffre unique mélangerait
        les sens et personne ne pourrait dire qu'il est faux.
      -->
      <Grid ColumnDefinitions="*,*,*,*">
        <Border Grid.Column="0" Classes="carte" Padding="18,14" Margin="0,0,10,0">
          <StackPanel Spacing="4">
            <TextBlock Text="Commissions" Classes="attenue" FontSize="12" />
            <TextBlock Text="{Binding Commissions}" Classes="chiffre" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="carte" Padding="18,14" Margin="0,0,10,0">
          <StackPanel Spacing="4">
            <TextBlock Text="Frais opérateur" Classes="attenue" FontSize="12" />
            <TextBlock Text="{Binding FraisOperateur}" Classes="chiffre" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="carte" Padding="18,14" Margin="0,0,10,0">
          <StackPanel Spacing="4">
            <TextBlock Text="Livraison" Classes="attenue" FontSize="12" />
            <TextBlock Text="{Binding Livraison}" Classes="chiffre" />
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Classes="carte" Padding="18,14">
          <StackPanel Spacing="4">
            <TextBlock Text="Remboursements" Classes="attenue" FontSize="12" />
            <TextBlock Text="{Binding Remboursements}" Classes="chiffre" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,420">

      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Grand livre de la plateforme"
                     Classes="groupe" Margin="6,4,6,8" />

          <ListBox ItemsSource="{Binding Ecritures}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:LigneEcriture">
                <Grid ColumnDefinitions="*,Auto" Margin="6">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Motif}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Rattachement}" Classes="attenue" FontSize="11" />
                    <TextBlock Text="{Binding Compte}" Classes="attenue" FontSize="11" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                    <!-- Le sens vient de `Direction`, pas du signe du montant :
                         `Amount` est toujours positif côté serveur. -->
                    <TextBlock Text="{Binding Montant}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Quand}" Classes="attenue" FontSize="11"
                               HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0">
        <DockPanel>

          <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">

            <TextBlock Text="Consulter un compte" Classes="titre" FontSize="18" />

            <!--
              PAR IDENTIFIANT, FAUTE DE ROUTE DE LISTE.

              Ni les portefeuilles vendeurs ni ceux des livreurs n'ont de route
              de liste : les deux seules routes disponibles sont adressées par
              GUID. L'identifiant se copie depuis Vendeurs, Livreurs, ou une
              ligne de reversement.
            -->
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="discret" Content="Vendeur" Command="{Binding ChoisirVendeur}"
                      Classes.actif="{Binding EstVendeur}" />
              <Button Classes="discret" Content="Livreur" Command="{Binding ChoisirLivreur}"
                      Classes.actif="{Binding EstLivreur}" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{Binding LibelleCompte}" Classes="attenue" FontSize="12" />
              <Border Classes="creux">
                <TextBox Text="{Binding Identifiant}"
                         FontFamily="Consolas,Menlo,monospace"
                         Watermark="00000000-0000-0000-0000-000000000000" />
              </Border>
            </StackPanel>

            <Button Classes="principal" Content="Consulter" Command="{Binding Consulter}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

            <TextBlock Classes="attenue" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding AErreurCompte}"
                       Foreground="{DynamicResource Danger}"
                       Text="{Binding ErreurCompte}" />

            <Border Classes="creux" Padding="16,14" IsVisible="{Binding ADesVendeur}">
              <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Text="Disponible" Classes="attenue" FontSize="11" />
                  <TextBlock Text="{Binding VendeurDisponible}" Classes="chiffre" />
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="À venir" Classes="attenue" FontSize="11" />
                  <TextBlock Text="{Binding VendeurAVenir}" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="Retenu par des retraits" Classes="attenue" FontSize="11" />
                  <TextBlock Text="{Binding VendeurRetenu}" FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock TextWrapping="Wrap" Classes="attenue" FontSize="11"
                           Text="« Retenu » compte les retraits demandés ET ceux partis chez le prestataire : dans les deux cas les fonds sont déjà sortis du solde disponible." />
              </StackPanel>
            </Border>

            <Border Classes="creux" Padding="16,14" IsVisible="{Binding ADesLivreur}">
              <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Text="Disponible" Classes="attenue" FontSize="11" />
                  <TextBlock Text="{Binding LivreurDisponible}" Classes="chiffre" />
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="Gagné depuis l'inscription" Classes="attenue" FontSize="11" />
                  <TextBlock Text="{Binding LivreurCumul}" FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock TextWrapping="Wrap" Classes="attenue" FontSize="11"
                           Text="Pas de solde « à venir » pour un livreur : une course est faite ou ne l'est pas, et aucun retour produit ne reprend le gain de celui qui a transporté le colis." />
              </StackPanel>
            </Border>
          </StackPanel>

          <ListBox ItemsSource="{Binding EcrituresCompte}" Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:LigneEcriture">
                <Grid ColumnDefinitions="*,Auto" Margin="6">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Motif}" FontSize="13" />
                    <TextBlock Text="{Binding Quand}" Classes="attenue" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Montant}" FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </DockPanel>
      </Border>

    </Grid>

  </DockPanel>
</UserControl>
