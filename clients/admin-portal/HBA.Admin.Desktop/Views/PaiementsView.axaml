<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             xmlns:svc="clr-namespace:HBA.Admin.Desktop.Services"
             x:Class="HBA.Admin.Desktop.Views.PaiementsView"
             x:DataType="vm:PaiementsViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <StackPanel Spacing="2">
        <TextBlock Text="Paiements" Classes="titre" />
        <TextBlock Classes="attenue" Text="{Binding Position}" />
      </StackPanel>

      <!--
        QUATRE CHIFFRES, ET DEUX PORTENT UN MONTANT.

        « Capturé » et « Remboursé » disent un NOMBRE et une SOMME : c'est la
        somme qui décide s'il faut s'inquiéter, pas le compte. « En attente » et
        « En échec » n'ont que le nombre — leur montant n'est pas rendu par
        `stats`, et l'inventer serait pire que l'omettre.
      -->
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Border Classes="carte" Padding="16,12" Width="250">
          <StackPanel Spacing="2">
            <TextBlock Text="Capturés" Classes="attenue" FontSize="12" />
            <TextBlock Text="{Binding Capture}" FontWeight="SemiBold" />
          </StackPanel>
        </Border>

        <Border Classes="carte" Padding="16,12" Width="130">
          <StackPanel Spacing="2">
            <TextBlock Text="En attente" Classes="attenue" FontSize="12" />
            <TextBlock Text="{Binding EnAttente}" FontWeight="SemiBold" />
          </StackPanel>
        </Border>

        <Border Classes="carte" Padding="16,12" Width="130">
          <StackPanel Spacing="2">
            <TextBlock Text="En échec" Classes="attenue" FontSize="12" />
            <TextBlock Text="{Binding Echoues}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Danger}" />
          </StackPanel>
        </Border>

        <Border Classes="carte" Padding="16,12" Width="250">
          <StackPanel Spacing="2">
            <TextBlock Text="Remboursés" Classes="attenue" FontSize="12" />
            <TextBlock Text="{Binding Rembourse}" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Grid ColumnDefinitions="*,190,Auto">
        <Border Grid.Column="0" Classes="creux" Margin="0,0,10,0">
          <TextBox Text="{Binding Recherche}" Watermark="Référence, commande, acheteur" />
        </Border>

        <ComboBox Grid.Column="1" Margin="0,0,10,0" MinHeight="44"
                  ItemsSource="{Binding Statuts}" SelectedItem="{Binding FiltreStatut}"
                  PlaceholderText="Statut" />

        <Button Grid.Column="2" Classes="principal" Content="Chercher" Command="{Binding Chercher}" />
      </Grid>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Danger}" />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding AConfirmation}">
        <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Succes}" />
      </Border>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="4,14,4,0">
      <Button Grid.Column="0" Classes="discret" Content="Précédente" Command="{Binding Precedente}" />
      <Button Grid.Column="2" Classes="discret" Content="Suivante" Command="{Binding Suivante}" />
    </Grid>

    <Grid ColumnDefinitions="*,340">

      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <ListBox ItemsSource="{Binding Paiements}" SelectedItem="{Binding Selection}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LignePaiement">
              <Grid ColumnDefinitions="140,110,*,120,130" Margin="6">
                <TextBlock Grid.Column="0" Text="{Binding MontantAffiche}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Statut}" Classes="attenue"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Prestataire}" FontSize="13" />
                  <TextBlock Text="{Binding Reference}" Classes="attenue" FontSize="12"
                             FontFamily="Consolas,Menlo,monospace"
                             IsVisible="{Binding AReference}" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding Commande}" Classes="attenue"
                           FontFamily="Consolas,Menlo,monospace" FontSize="13"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding CreeLe}" Classes="attenue"
                           FontSize="12" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0">
        <DockPanel>

          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Rattrapage" Classes="titre" FontSize="18" />

            <!--
              LE MOT « RATTRAPAGE » EST CHOISI.

              Ces gestes ne sont pas le cycle de vie normal d'un paiement : un
              paiement Mobile Money se capture par le webhook du prestataire. Les
              nommer « actions » laisserait croire qu'on les emploie couramment.
            -->
            <TextBlock Classes="attenue" TextWrapping="Wrap"
                       Text="À n'employer que si le prestataire n'a pas répondu." />

            <TextBlock Classes="attenue" TextWrapping="Wrap"
                       IsVisible="{Binding !ADesSelection}"
                       Text="Sélectionnez un paiement dans la liste." />

            <TextBlock TextWrapping="Wrap"
                       IsVisible="{Binding ADesSelection}"
                       Text="{Binding Selection.MontantAffiche}"
                       FontWeight="SemiBold" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Gestes}" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="svc:GestePaiement">
                <Button Classes="danger"
                        Content="{Binding Libelle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,0,0,8"
                        Command="{Binding $parent[ItemsControl].((vm:PaiementsViewModel)DataContext).Agir}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </DockPanel>
      </Border>

    </Grid>

  </DockPanel>

</UserControl>
