<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             x:Class="HBA.Admin.Desktop.Views.RolesView"
             x:DataType="vm:RolesViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Rôles" Classes="titre" />
          <TextBlock Classes="attenue" Text="{Binding Position}" />
        </StackPanel>

        <Button Grid.Column="1" Classes="discret" Content="Actualiser" Margin="0,0,10,0"
                Command="{Binding Rafraichir}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="principal" Content="Nouveau rôle"
                Command="{Binding Creer}" VerticalAlignment="Center" />
      </Grid>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding AConfirmation}">
        <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" Foreground="{DynamicResource Succes}" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="380,*">

      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Selection}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LigneRole">
              <Grid ColumnDefinitions="*,Auto" Margin="6">
                <StackPanel Grid.Column="0" Spacing="1">
                  <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Compte}" Classes="attenue" FontSize="12" />
                </StackPanel>

                <!-- Un rôle système se reconnaît avant d'être cliqué : c'est le
                     seul qui refusera la suppression. -->
                <Border Grid.Column="1" Classes="pastille" IsVisible="{Binding EstSysteme}"
                        VerticalAlignment="Center">
                  <TextBlock Text="système" FontSize="10" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0">
        <DockPanel>

          <TextBlock DockPanel.Dock="Top" Classes="attenue" TextWrapping="Wrap"
                     IsVisible="{Binding !ADesSelection}"
                     Text="Sélectionnez un rôle, ou créez-en un." />

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                      Margin="0,14,0,0" IsVisible="{Binding ADesSelection}">
            <Button Classes="principal" Content="Enregistrer le nom" Command="{Binding Enregistrer}" />
            <Button Classes="principal" Content="Enregistrer les permissions"
                    Command="{Binding EnregistrerPermissions}" />
            <Button Classes="danger" Content="Supprimer" Command="{Binding Supprimer}" />
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding ADesSelection}">

            <TextBlock Text="Identité du rôle" Classes="titre" FontSize="18" />

            <TextBlock Classes="attenue" TextWrapping="Wrap" IsVisible="{Binding EstSysteme}"
                       Text="Rôle système : ses permissions se modifient, mais il ne peut pas être supprimé." />

            <StackPanel Spacing="8">
              <TextBlock Text="Nom" Classes="attenue" FontSize="12" />
              <Border Classes="creux"><TextBox Text="{Binding Nom}" /></Border>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Description" Classes="attenue" FontSize="12" />
              <Border Classes="creux"><TextBox Text="{Binding Description}" /></Border>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Permissions — une par ligne, format ressource.action"
                         Classes="attenue" FontSize="12" />

              <!--
                ENREGISTRER LES PERMISSIONS REMPLACE LA LISTE ENTIÈRE.

                `SetRolePermissionsCommand` pose ce qu'il reçoit à la place de
                l'ancien : une ligne effacée ici est une permission RETIRÉE. Ce
                n'est pas un ajout, et le libellé du bouton le dit.
              -->
              <Border Classes="creux">
                <TextBox Text="{Binding Permissions}"
                         AcceptsReturn="True"
                         MinHeight="240"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas,Menlo,monospace"
                         Watermark="catalog.write&#x0a;payout.read" />
              </Border>
            </StackPanel>

          </StackPanel>

        </DockPanel>
      </Border>

    </Grid>

  </DockPanel>
</UserControl>
