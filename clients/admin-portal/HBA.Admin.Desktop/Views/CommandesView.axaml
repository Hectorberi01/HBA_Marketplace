<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             xmlns:svc="clr-namespace:HBA.Admin.Desktop.Services"
             x:Class="HBA.Admin.Desktop.Views.CommandesView"
             x:DataType="vm:CommandesViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <StackPanel Spacing="2">
        <TextBlock Text="Commandes" Classes="titre" />
        <TextBlock Classes="attenue" Text="{Binding Position}" />
      </StackPanel>

      <Border Classes="creux" Padding="14,11">
        <TextBlock TextWrapping="Wrap" Classes="attenue"
                   Text="Cet écran arbitre les commandes bloquées : relancer, ou rembourser et clore. Les commandes REPAS ont les mêmes deux gestes, mais aucune route ne les liste — il faut connaître leur identifiant." />
      </Border>

      <Grid ColumnDefinitions="*,200,Auto">
        <Border Grid.Column="0" Classes="creux" Margin="0,0,10,0">
          <TextBox Text="{Binding Recherche}" Watermark="Référence, acheteur" />
        </Border>

        <ComboBox Grid.Column="1" Margin="0,0,10,0" MinHeight="44"
                  ItemsSource="{Binding Statuts}" SelectedItem="{Binding FiltreStatut}"
                  PlaceholderText="Statut" />

        <Button Grid.Column="2" Classes="principal" Content="Chercher" Command="{Binding Chercher}" />
      </Grid>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding AConfirmation}">
        <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" Foreground="{DynamicResource Succes}" />
      </Border>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="4,14,4,0">
      <Button Grid.Column="0" Classes="discret" Content="Précédente" Command="{Binding Precedente}" />
      <Button Grid.Column="2" Classes="discret" Content="Suivante" Command="{Binding Suivante}" />
    </Grid>

    <Grid ColumnDefinitions="*,340">
      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <ListBox ItemsSource="{Binding Commandes}" SelectedItem="{Binding Selection}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LigneCommande">
              <Grid ColumnDefinitions="140,150,*,130" Margin="6">
                <TextBlock Grid.Column="0" Text="{Binding MontantAffiche}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />

                <!-- L'arbitrage se repère à la couleur : c'est la seule ligne actionnable. -->
                <TextBlock Grid.Column="1" Text="{Binding Statut}" VerticalAlignment="Center"
                           Classes="attenue" />
                <TextBlock Grid.Column="1" Text="{Binding Statut}" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource Alerte}"
                           IsVisible="{Binding EnArbitrage}" />

                <TextBlock Grid.Column="2" Text="{Binding Acheteur}" Classes="attenue"
                           FontFamily="Consolas,Menlo,monospace" FontSize="13"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding CreeeLe}" Classes="attenue"
                           FontSize="12" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Arbitrage" Classes="titre" FontSize="18" />
            <TextBlock Classes="attenue" TextWrapping="Wrap"
                       Text="Disponible uniquement sur une commande en arbitrage." />
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                       IsVisible="{Binding ADesSelection}"
                       Text="{Binding Selection.MontantAffiche}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Gestes}" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="svc:GesteCommande">
                <Button Classes="discret" Classes.danger="{Binding Destructeur}"
                        Content="{Binding Libelle}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Margin="0,0,0,8"
                        Command="{Binding $parent[ItemsControl].((vm:CommandesViewModel)DataContext).Agir}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>

  </DockPanel>
</UserControl>
