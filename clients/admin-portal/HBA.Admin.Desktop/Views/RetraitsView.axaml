<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBA.Admin.Desktop.ViewModels"
             xmlns:svc="clr-namespace:HBA.Admin.Desktop.Services"
             x:Class="HBA.Admin.Desktop.Views.RetraitsView"
             x:DataType="vm:RetraitsViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,14">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Retraits" Classes="titre" />
          <TextBlock Classes="attenue" Text="{Binding Position}" />
        </StackPanel>

        <Button Grid.Column="1" Classes="discret" Content="Actualiser"
                Command="{Binding Rafraichir}" VerticalAlignment="Center" />
      </Grid>

      <!--
        TROIS FILES, TROIS BOUTONS — pas un sélecteur.

        Un menu déroulant cacherait qu'il existe une file cliente, et c'est
        justement celle dont le traitement est manuel. Ce qui est caché n'est pas
        traité.
      -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="discret" Classes.actif="{Binding SurPartenairesEnAttente}"
                Content="Vendeurs &amp; livreurs" Command="{Binding Choisir}" CommandParameter="attente" />
        <Button Classes="discret" Classes.actif="{Binding SurPartenairesEnCours}"
                Content="En cours" Command="{Binding Choisir}" CommandParameter="en-cours" />
        <Button Classes="discret" Classes.actif="{Binding SurClients}"
                Content="Clients" Command="{Binding Choisir}" CommandParameter="clients" />
      </StackPanel>

      <Border Classes="creux" Padding="14,11">
        <TextBlock Text="{Binding Explication}" TextWrapping="Wrap" Classes="attenue" />
      </Border>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding EnCours}" Height="3" />

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding EnErreur}">
        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Danger}" />
      </Border>

      <Border Classes="carte" Padding="16,12" IsVisible="{Binding AConfirmation}">
        <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Succes}" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,340">

      <Border Grid.Column="0" Classes="carte" Margin="4,0,10,0" Padding="8">
        <ListBox ItemsSource="{Binding Retraits}"
                 SelectedItem="{Binding Selection}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:LigneRetrait">
              <Grid ColumnDefinitions="150,*,130,130" Margin="6">

                <!-- Le montant en premier : c'est ce qu'on lit d'abord. -->
                <TextBlock Grid.Column="0" Text="{Binding MontantAffiche}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Demandeur}" FontFamily="Consolas,Menlo,monospace" FontSize="13" />
                  <TextBlock Text="{Binding Destination}" Classes="attenue" FontSize="12"
                             IsVisible="{Binding ADestination}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Statut}" Classes="attenue"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding DemandeLe}" Classes="attenue"
                           FontSize="12" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="carte" Margin="0,0,4,0">
        <DockPanel>

          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Décisions" Classes="titre" FontSize="18" />

            <TextBlock Classes="attenue" TextWrapping="Wrap"
                       IsVisible="{Binding !ADesSelection}"
                       Text="Sélectionnez une demande dans la liste." />

            <TextBlock Classes="attenue" TextWrapping="Wrap"
                       IsVisible="{Binding ADesSelection}"
                       Text="{Binding Selection.Resume}" />

            <!-- La destination est LA donnée à recopier chez le prestataire. -->
            <Border Classes="creux" Padding="12" Margin="0,8,0,0"
                    IsVisible="{Binding Selection.ADestination, FallbackValue=False}">
              <StackPanel Spacing="2">
                <TextBlock Text="Destination figée à la demande" Classes="attenue" FontSize="11" />
                <TextBlock Text="{Binding Selection.Destination}"
                           FontFamily="Consolas,Menlo,monospace"
                           FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock DockPanel.Dock="Top"
                     Classes="attenue"
                     TextWrapping="Wrap"
                     IsVisible="{Binding AucunGeste}"
                     Text="Rien à décider sur cette file : le prestataire n'a pas encore répondu." />

          <ItemsControl ItemsSource="{Binding Gestes}" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="svc:GesteRetrait">

                <!--
                  LES QUATRE GESTES SONT ROUGES, ET CE N'EST PAS UNE ERREUR.

                  Ailleurs, le rouge distingue le geste destructeur du geste
                  ordinaire. Ici les deux sens engagent de l'argent réel :
                  approuver le fait sortir, refuser le retient. Il n'y a pas de
                  geste anodin sur cet écran.
                -->
                <Button Classes="danger"
                        Content="{Binding Libelle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,0,0,8"
                        Command="{Binding $parent[ItemsControl].((vm:RetraitsViewModel)DataContext).Agir}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </DockPanel>
      </Border>

    </Grid>

  </DockPanel>

</UserControl>
