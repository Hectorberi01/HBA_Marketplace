<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    ═══════════════════════════════════════════════════════════════════════════
    PALETTE DU BACK-OFFICE.

    TEINTE DISTINCTE DE CELLE DES CONSOLES VENDEUR ET CLIENT — DÉLIBÉRÉMENT.

    Les règles neumorphiques sont les MÊMES que celles de
    `clients/seller-portal/Web/src/app/globals.css` : mêmes ombres jumelles,
    même source de lumière en haut-gauche, même rayon. Ce qui change est la
    teinte d'accent : indigo ardoise ici, vert de marque #087A59 là-bas.

    Ce n'est pas un choix esthétique. Un administrateur travaille avec la console
    vendeur ouverte à côté — pour voir ce que voit le vendeur dont il traite le
    dossier. Deux écrans de même teinte, c'est une suspension prononcée depuis la
    mauvaise fenêtre. La couleur est ici un garde-fou, pas une décoration.

    LES VALEURS D'OMBRE VIENNENT DE `globals.css`, PAS D'UNE APPROXIMATION.

    Les variables `nm-light` (255 255 255) et `nm-dark` (218 222 228, soit
    #DADEE4) y sont documentées comme « quasi-blanc, remplace #a3b1c6 » : la
    teinte d'ombre a déjà été corrigée une fois là-bas pour retirer le bleu. La
    recopier évite de refaire la même correction ici dans six mois.

    ET LEURS NOMS SONT ÉCRITS SANS LEUR PRÉFIXE CSS, VOLONTAIREMENT.

    Un double tiret est INTERDIT dans un commentaire XML. Recopier
    « (deux tirets)nm-light » depuis la feuille de style fait échouer l'analyse
    du fichier au chargement, avec un « not well-formed » qui désigne une colonne
    et pas la cause.
    ═══════════════════════════════════════════════════════════════════════════
  -->

  <!-- Fond et surfaces : la MÊME couleur. C'est la condition du neumorphisme —
       une surface qui se détache par sa couleur n'a plus besoin de relief, et
       les deux effets se contredisent. -->
  <Color x:Key="CouleurFond">#EEF0F3</Color>
  <SolidColorBrush x:Key="FondApp" Color="{StaticResource CouleurFond}" />
  <SolidColorBrush x:Key="FondSurface" Color="{StaticResource CouleurFond}" />

  <!-- Texte : contraste AA conservé sur le fond ci-dessus. -->
  <SolidColorBrush x:Key="Texte" Color="#252B41" />
  <SolidColorBrush x:Key="TexteAttenue" Color="#5B6472" />
  <SolidColorBrush x:Key="TexteSurAccent" Color="#FFFFFF" />

  <!-- Accent admin : indigo ardoise. -->
  <SolidColorBrush x:Key="Accent" Color="#3B4B8F" />
  <SolidColorBrush x:Key="AccentSombre" Color="#2C3A70" />
  <SolidColorBrush x:Key="AccentDoux" Color="#E4E8F5" />

  <!--
    ROUGE RÉSERVÉ AUX GESTES IRRÉVERSIBLES, PAS AUX ERREURS DE SAISIE.

    Suspendre un vendeur, rejeter un KYB, annuler un lot de versement. Si le
    rouge sert aussi à « e-mail invalide », il cesse d'être un signal et devient
    une couleur parmi d'autres — au moment précis où il devrait arrêter la main.
  -->
  <SolidColorBrush x:Key="Danger" Color="#C62828" />
  <SolidColorBrush x:Key="DangerDoux" Color="#F7E4E4" />

  <SolidColorBrush x:Key="Succes" Color="#1F7A4D" />
  <SolidColorBrush x:Key="Alerte" Color="#B26A00" />

  <!-- Rayon : 0.9rem = 14 px dans `globals.css`. -->
  <CornerRadius x:Key="Rayon">14</CornerRadius>
  <CornerRadius x:Key="RayonPetit">10</CornerRadius>

</ResourceDictionary>
