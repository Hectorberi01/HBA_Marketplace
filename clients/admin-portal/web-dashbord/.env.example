# ── Ou le NAVIGATEUR envoie ses requetes ────────────────────────────────────
#
# `same-origin` : les appels partent en relatif (/api/...) et le serveur de
# developpement les relaie vers VITE_API_PROXY_TARGET ci-dessous. C'est ce
# qu'il faut en local, parce que la passerelle ne declare aucune origine CORS.
#
# Une URL absolue : les appels partent directement vers elle. Utile seulement
# une fois que la passerelle autorise l'origine du portail.
#
# Sans cette variable, le portail REFUSE DE DEMARRER en nommant ce qui manque —
# voir src/config/env.ts.
VITE_API_BASE_URL=same-origin

# ── Ou le SERVEUR DE DEVELOPPEMENT relaie ───────────────────────────────────
#
# Lu par vite.config.ts uniquement, jamais par le code de l'application.
VITE_API_PROXY_TARGET=https://api.hba-express.com
