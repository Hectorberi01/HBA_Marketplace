COMPOSE_PROJECT_NAME=hba

ASPNETCORE_ENVIRONMENT=Production

REGISTRY=ghcr.io/hba

POSTGRES_USER=hba
POSTGRES_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=hba
MINIO_ROOT_PASSWORD=

JWT_SIGNING_KEY=
INTERNAL_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# IDENTITÉ D'APPELANT gRPC — ENGENDRÉE, PAS INVENTÉE.
#
# NE RIEN ÉCRIRE À LA MAIN ICI.
#
#     scripts/generer-identites-internes.sh
#
# écrit un `identites.env` dont le contenu se recopie tel quel ci-dessous. Les
# valeurs sont du base64 de DER : une clé retapée ou tronquée produit un
# `Unauthenticated` que rien ne rattache à ce fichier.
#
# CE QUE CES CLÉS AJOUTENT À `INTERNAL_API_KEY`.
#
# `INTERNAL_API_KEY` est LA MÊME pour les quatorze hôtes : elle atteste
# l'appartenance au réseau, pas l'identité. Un service compromis la lit et
# appelle dès lors n'importe quel RPC en se présentant comme n'importe qui.
# Chaque `INTERNAL_KEY_*` ci-dessous est propre à UN hôte ; la compromettre
# permet d'usurper cet hôte-là et aucun autre.
#
# `INTERNAL_PUBLIC_KEYS` ne contient que des clés PUBLIQUES : la même valeur
# pour tous, aucune valeur pour un attaquant.
#
# UNE ROTATION SE DÉPLOIE EN UNE FOIS, PAS SERVICE PAR SERVICE — sans quoi
# les hôtes déjà redémarrés refusent ceux qui ne le sont pas encore.
# ─────────────────────────────────────────────────────────────────────────────
INTERNAL_KEY_HBA_IDENTITY_API=
INTERNAL_KEY_HBA_USERS_API=
INTERNAL_KEY_HBA_MERCHANTS_API=
INTERNAL_KEY_HBA_CATALOG_API=
INTERNAL_KEY_HBA_INVENTORY_API=
INTERNAL_KEY_HBA_COMMERCE_API=
INTERNAL_KEY_HBA_ORDER_API=
INTERNAL_KEY_HBA_FOOD_RESTAURANT_API=
INTERNAL_KEY_HBA_DELIVERY_CORE_API=
INTERNAL_KEY_HBA_FINANCIAL_API=
INTERNAL_KEY_HBA_ENGAGEMENT_API=
INTERNAL_KEY_HBA_COMMUNICATION_API=
INTERNAL_KEY_HBA_MEDIA_API=
INTERNAL_KEY_HBA_GATEWAY_API=

INTERNAL_PUBLIC_KEYS=

API_DOMAIN=
GRAFANA_DOMAIN=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# PREMIER ADMINISTRATEUR (identity-service).
#
# Créer un admin exige d'être admin : sur une base neuve, personne ne l'est.
# Sans ces deux valeurs, le compose refuse de démarrer — mieux vaut un échec net
# qu'une plateforme installée dans laquelle personne ne peut entrer.
#
# ADMIN_PASSWORD EST UN SECRET. Ne pas le commiter renseigné.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# E-MAIL (Resend) — OBLIGATOIRE.
#
# Sans canal e-mail, aucune adresse ne peut être vérifiée et aucun mot de passe
# oublié ne peut être récupéré. Le domaine de EMAIL_FROM doit être vérifié chez
# Resend (SPF + DKIM) : sinon Resend répond 403 et l'outbox rejoue en boucle.
#
# RESEND_API_KEY EST UN SECRET.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# PUSH (Firebase Cloud Messaging) — FACULTATIF.
#
# Vide ⇒ aucun push, et la raison est journalisée au démarrage. Renseigner l'UN
# des deux : le JSON du compte de service en ligne, ou le chemin d'un fichier
# monté dans le conteneur.
#
# CE JSON CONTIENT UNE CLÉ PRIVÉE.
# ─────────────────────────────────────────────────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=
