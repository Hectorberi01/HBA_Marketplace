SERVICE_NAME=identity-service
ASPNETCORE_ENVIRONMENT=Production
HOSTING__HTTPPORT=8080
HOSTING__GRPCPORT=8081
AUTHENTICATION__ISSUER=hba-identity
AUTHENTICATION__AUDIENCE=hba-platform
KAFKA__CONSUMERGROUP=hba-identity-service
JWT__ISSUER=hba-identity
JWT__AUDIENCE=hba-platform
JWT__ACCESSTOKENEXPIRATIONMINUTES=15
JWT__REFRESHTOKENEXPIRATIONDAYS=30
AUTHENTICATION__REQUIRECONFIRMEDEMAIL=true
AUTHENTICATION__MAXFAILEDACCESSATTEMPTS=5
AUTHENTICATION__LOCKOUTMINUTES=15
OTP__EXPIRATIONMINUTES=5
OTP__LENGTH=6
OTP__MAXATTEMPTS=5

KAFKA__PRODUCER=identity-service

# ─────────────────────────────────────────────────────────────────────────────
# PREMIER ADMINISTRATEUR.
#
# ADMIN__PASSWORD EST UN SECRET : NE PAS LE RENSEIGNER ICI.
#
# Ce fichier décrit la forme attendue ; la valeur vient de l'orchestrateur, au
# même titre que JWT_SIGNING_KEY. Le service REFUSE de démarrer si l'adresse ou
# le mot de passe manque hors Development — un avertissement se perdrait dans le
# flux de quatorze conteneurs, et le symptôme n'apparaîtrait qu'à la première
# tentative de connexion.
#
# L'amorçage est idempotent : il ne réinitialise jamais un mot de passe existant.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN__EMAIL=
ADMIN__PASSWORD=
ADMIN__FIRSTNAME=Admin
ADMIN__LASTNAME=Plateforme
ADMIN__PHONE=+22900000000
