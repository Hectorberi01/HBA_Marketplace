SERVICE_NAME=communication-service

ASPNETCORE_ENVIRONMENT=Development
# ─────────────────────────────────────────────────────────────────────────────
# ASPNETCORE_URLS A ÉTÉ RETIRÉ, ET C'EST DÉLIBÉRÉ.
#
# Le service ouvre DEUX ports : 8080 en REST/HTTP1 pour la passerelle, 8081 en
# gRPC/HTTP2 pour les autres services. Cette configuration passe par
# `ListenAnyIP` dans le code — et dès qu'un `Listen*` explicite existe, Kestrel
# IGNORE ENTIÈREMENT `ASPNETCORE_URLS`.
#
# La laisser ici aurait été le pire des cas : une variable présente, lisible,
# modifiable, et sans le moindre effet. Quelqu'un aurait changé le port là et
# cherché longtemps pourquoi rien ne bouge.
# ─────────────────────────────────────────────────────────────────────────────
HOSTING__HTTPPORT=8080
HOSTING__GRPCPORT=8081

KAFKA__CONSUMERGROUP=hba-communication-service

# Notifications
NOTIFICATIONS__PUSHENABLED=true
NOTIFICATIONS__SMSENABLED=true
NOTIFICATIONS__EMAILENABLED=true

# Messaging
MESSAGING__MAXMESSAGELENGTH=5000
MESSAGING__MAXATTACHMENTS=5

# SMS
SMS__DEFAULTCOUNTRYCODE=229

# Internal services
SERVICES__USER=http://user-service:9090
SERVICES__MEDIA=http://media-service:9090
SERVICES__ORDER=http://order-service:9090
SERVICES__DELIVERY=http://delivery-service:9090

# Clients gRPC de la tranche Notifications. Absentes, elles font ÉCHOUER le
# démarrage : les trois enregistrements lèvent si leur adresse manque.
# Products est hébergé par catalog-service.
SERVICES__CATALOG=http://catalog-service:9090
SERVICES__MERCHANT=http://merchant-service:9090
SERVICES__IDENTITY=http://identity-service:9090

KAFKA__PRODUCER=communication-service

# ─────────────────────────────────────────────────────────────────────────────
# E-MAIL (Resend) ET PUSH (FCM).
#
# AUCUN SECRET ICI. Ce fichier décrit la forme ; les valeurs viennent de
# l'orchestrateur, comme JWT_SIGNING_KEY.
#
# Le service REFUSE de démarrer en Production sans configuration e-mail : sans
# canal, ni vérification d'adresse ni réinitialisation de mot de passe ne sont
# possibles, et les utilisateurs qui oublient le leur restent bloqués dehors.
#
# FCM, lui, se replie en silence sur NullPushSender : ne pas recevoir de push
# est gênant, cela n'enferme personne.
# ─────────────────────────────────────────────────────────────────────────────
NOTIFICATIONS__EMAIL__APIKEY=
NOTIFICATIONS__EMAIL__FROM=
NOTIFICATIONS__EMAIL__APPBASEURL=

NOTIFICATIONS__FCM__SERVICEACCOUNTJSON=
NOTIFICATIONS__FCM__SERVICEACCOUNTPATH=
