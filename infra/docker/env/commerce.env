SERVICE_NAME=commerce-service
ASPNETCORE_ENVIRONMENT=Development
HOSTING__HTTPPORT=8080
HOSTING__GRPCPORT=8081
KAFKA__CONSUMERGROUP=hba-commerce-service
CART__EXPIRATIONDAYS=30
CART__MAXITEMS=100
CART__FOOD__SINGLERESTAURANT=true
CART__MARKETPLACE__ALLOWMULTIPLESTORES=true
WISHLIST__MAXITEMS=500
PRICING__CURRENCY=XOF
SERVICES__CATALOG=http://catalog-service:9090
SERVICES__INVENTORY=http://inventory-service:9090
SERVICES__FOOD=http://food-service:9090
SERVICES__MERCHANT=http://merchant-service:9090

KAFKA__PRODUCER=commerce-service
