SERVICE_NAME=gateway
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
AUTHENTICATION__ISSUER=hba-identity
AUTHENTICATION__AUDIENCE=hba-platform
AUTHENTICATION__REQUIREHTTPSMETADATA=true
SERVICES__IDENTITY=http://identity-service:9090
SERVICES__USER=http://user-service:9090
SERVICES__MERCHANT=http://merchant-service:9090
SERVICES__CATALOG=http://catalog-service:9090
SERVICES__INVENTORY=http://inventory-service:9090
SERVICES__COMMERCE=http://commerce-service:9090
SERVICES__ORDER=http://order-service:9090
SERVICES__FOOD=http://food-service:9090
SERVICES__DELIVERY=http://delivery-service:9090
SERVICES__FINANCIAL=http://financial-service:9090
SERVICES__ENGAGEMENT=http://engagement-service:9090
SERVICES__COMMUNICATION=http://communication-service:9090
SERVICES__MEDIA=http://media-service:9090
SERVICES__PROMOTION=http://promotion-service:9090
OPENTELEMETRY__SERVICENAME=hba-gateway
OPENTELEMETRY__ENDPOINT=http://otel-collector:4317
RATELIMITING__GLOBAL__PERMITLIMIT=300
RATELIMITING__GLOBAL__WINDOWSECONDS=60
RATELIMITING__AUTH__PERMITLIMIT=10
RATELIMITING__AUTH__WINDOWSECONDS=60
RATELIMITING__OTP__PERMITLIMIT=5
RATELIMITING__OTP__WINDOWSECONDS=300
RATELIMITING__READ__PERMITLIMIT=200
RATELIMITING__READ__WINDOWSECONDS=60
RATELIMITING__WRITE__PERMITLIMIT=60
RATELIMITING__WRITE__WINDOWSECONDS=60
PROXYTRUST__TRUSTANYPROXY=true

# ─────────────────────────────────────────────────────────────────────────────
# DOCUMENTATION OPENAPI — FERMÉE.
#
# Cette pile vise un serveur exposé sur Internet. La page /docs y donnerait la
# liste complète des routes de la passerelle, leurs paramètres et leurs schémas,
# et signalerait au passage les surfaces d'administration.
#
# Le défaut du code est déjà « faux hors Development » ; la clé est écrite ici
# pour que le choix soit visible plutôt que déduit.
# ─────────────────────────────────────────────────────────────────────────────
OPENAPI__ENABLED=false
