# Copier en `staging.yml` — ignoré par Git : ce fichier porte des IP réelles.
#
# LES VALEURS VIENNENT DE TERRAFORM, PAS D'UN RELEVÉ À LA MAIN.
#
#   cd ../../terraform/environments/staging
#   terraform output -json noeuds
#
# Recopier une IP de mémoire après une reconstruction est le meilleur moyen de
# durcir la mauvaise machine — et l'on ne s'en aperçoit qu'au moment où le
# playbook réussit sur un nœud qui n'appartient plus au cluster.
---
all:
  vars:
    ansible_user: ubuntu
    environnement: staging

    # NOM DE L'INTERFACE PRIVÉE — À VÉRIFIER, PAS À SUPPOSER.
    #
    # Sur les instances OVH Ubuntu 24.04, la seconde carte est en général `ens4`,
    # mais l'ordre d'énumération n'est pas garanti. Une valeur fausse ici donne un
    # k3s qui annonce la mauvaise adresse : le cluster se forme, et le trafic
    # entre pods sort sur Internet.
    #
    #   ssh ubuntu@<ip> ip -br addr
    interface_privee: ens4

  children:
    serveurs:
      hosts:
        hba-staging-1:
          ansible_host: 203.0.113.11   # ip_public
          ip_privee: 10.0.0.11         # ip_prive
    agents:
      hosts:
        hba-staging-2:
          ansible_host: 203.0.113.12
          ip_privee: 10.0.0.12
