# Copier en `production.yml` — ignoré par Git.
#
# Valeurs issues de `terraform output -json noeuds` dans
# `../../terraform/environments/production`. Voir `staging.yml.example` pour les
# encadrés — ils valent à l'identique ici.
#
# TROIS SERVEURS k3s. Le rôle démarre le premier avec `--cluster-init`, puis
# joint les deux autres au même plan de contrôle embarqué.
---
all:
  vars:
    ansible_user: ubuntu
    environnement: production
    interface_privee: ens4

  children:
    serveurs:
      hosts:
        hba-production-1:
          ansible_host: 203.0.113.21
          ip_privee: 10.1.0.11
        hba-production-2:
          ansible_host: 203.0.113.22
          ip_privee: 10.1.0.12
        hba-production-3:
          ansible_host: 203.0.113.23
          ip_privee: 10.1.0.13
    agents:
      hosts: {}
