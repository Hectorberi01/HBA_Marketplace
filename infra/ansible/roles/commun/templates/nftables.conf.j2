#!/usr/sbin/nft -f
# Posé par Ansible — rôle `commun`. Toute modification à la main sera écrasée.
#
# CE QUI EST OUVERT SUR L'INTERFACE PUBLIQUE, ET RIEN D'AUTRE (§1, §5) :
#     22   SSH        — administration
#     80   HTTP       — redirection vers 443 et challenge ACME HTTP-01
#     443  HTTPS      — l'Ingress
#
# PostgreSQL, Redis, Kafka, MinIO, les ports gRPC et l'API Kubernetes (6443)
# n'apparaissent NULLE PART ici : ils ne transitent que par le réseau privé,
# dont l'interface est acceptée en bloc plus bas.

flush ruleset

table inet filtre {
  chain entrant {
    type filter hook input priority 0; policy drop;

    # Les connexions déjà établies — sans cette règle, TOUTE réponse à une
    # requête sortante serait jetée, y compris `apt update`.
    ct state established,related accept
    ct state invalid drop

    iif lo accept

    # LE RÉSEAU PRIVÉ EST ACCEPTÉ EN BLOC, ET C'EST ASSUMÉ.
    #
    # k3s ouvre entre nœuds bien plus que trois ports : 6443, 10250, VXLAN 8472,
    # les NodePorts, plus ce que les opérateurs Postgres et Kafka ajoutent. Les
    # énumérer ici produirait une liste fausse au premier ajout — et le symptôme
    # serait un pod qui ne démarre pas sur UN nœud seulement.
    #
    # La segmentation fine est le travail des NetworkPolicies, qui, elles,
    # connaissent les pods. Cette interface n'est pas routée depuis Internet.
    iifname "{{ interface_privee | default('ens4') }}" accept

    # ═════════════════════════════════════════════════════════════════════
    # LE TRAFIC VENU DES PODS. SANS LUI, LE CLUSTER NE DÉMARRE PAS.
    #
    # CETTE RÈGLE MANQUAIT, ET TROIS PODS SYSTÈME TOMBAIENT EN BOUCLE.
    #
    # Un pod qui appelle l'API Kubernetes vise `10.43.0.1:443`. La traduction
    # vers le port 6443 de l'HÔTE se fait avant la chaîne d'entrée : le paquet y
    # arrive donc comme un paquet destiné à la machine, avec une adresse source
    # du réseau des pods. Aucune règle ne le couvrait — `policy drop` l'emportait.
    #
    # LE SYMPTÔME NE DÉSIGNE PAS LE PARE-FEU. Le nœud passe `Ready` : kubelet,
    # lui, parle à l'API depuis l'hôte, pas depuis un pod. Ce sont les charges
    # qui échouent — `metrics-server` et `local-path-provisioner` en
    # `CrashLoopBackOff`, `coredns` qui reste `0/1` faute de pouvoir lister les
    # services. On lit alors les journaux des pods, où il n'y a qu'un délai
    # d'attente vers 10.43.0.1.
    #
    # POURQUOI `iifname interface_privee` NE SUFFISAIT PAS. Cette ligne visait un
    # réseau privé entre nœuds. Le trafic pod → hôte n'y passe jamais : il entre
    # par le pont du CNI. Sur cette installation, `interface_privee` vaut de plus
    # `wg0`, une interface qui n'existe pas encore — la règle n'acceptait donc
    # strictement rien.
    #
    # ON ACCEPTE LES DEUX RÉSEAUX EN BLOC, comme le prescrit la documentation de
    # k3s. Les énumérer port par port produirait une liste fausse au premier
    # composant ajouté. Ces adresses ne sont pas routables depuis Internet, et la
    # segmentation entre pods est le travail des NetworkPolicies.
    # ═════════════════════════════════════════════════════════════════════
    ip saddr {{ '{' }} {{ cidr_pods }}, {{ cidr_services }} {{ '}' }} accept

    tcp dport 22 accept
    tcp dport { 80, 443 } accept
{% if postgres_sur_hote | default(false) %}

    # POSTGRESQL TOURNE SUR CETTE MACHINE, ET LES PODS DOIVENT L'ATTEINDRE.
    #
    # Sans cette règle, le trafic d'un pod vers la base est jeté par la
    # politique `drop` d'entrée : il n'arrive ni par `lo`, ni par l'interface
    # nommée dans `interface_privee`, mais par le pont CNI. Le symptôme est un
    # DÉLAI D'ATTENTE côté service, jamais un refus — et le diagnostic part vers
    # PostgreSQL, qui tourne parfaitement.
    #
    # DEUX ADRESSES SOURCES, PARCE QU'ON NE PEUT PAS SAVOIR LAQUELLE ARRIVE.
    #
    # Un paquet partant d'un pod vers l'IP de son propre nœud est masqué ou non
    # selon les règles que k3s installe : la source vue ici est soit l'adresse
    # du pod, soit celle du nœud. Les deux sont acceptées — n'en mettre qu'une
    # marcherait sur une version de k3s et pas sur la suivante, sans que rien
    # ne relie la panne à cette ligne.
    #
    # CE QUE CETTE RÈGLE N'OUVRE PAS : l'extérieur. 5432 reste absent de la
    # liste publique ci-dessus, et l'Internet n'a aucune route vers
    # {{ cidr_pods }}.
    ip saddr {{ '{' }} {{ cidr_pods }}, {{ ip_privee }} {{ '}' }} tcp dport 5432 accept
{% endif %}

    # ICMP : indispensable à la découverte de MTU. Le bloquer produit des
    # connexions qui s'établissent puis se figent sur les gros transferts —
    # typiquement un upload d'image de 15 Mo qui n'aboutit jamais.
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept
  }

  chain transfert {
    # k3s pose ses propres règles de forward pour les pods. On ne fixe pas la
    # politique à `drop` ici : cela couperait le trafic entre pods de nœuds
    # différents, et le symptôme — un service joignable depuis certains pods
    # seulement — est parmi les plus longs à diagnostiquer.
    type filter hook forward priority 0; policy accept;
  }

  chain sortant {
    type filter hook output priority 0; policy accept;
  }
}
