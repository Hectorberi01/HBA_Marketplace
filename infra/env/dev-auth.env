# Le socle d'authentification partage par les services, en developpement.
#
# C'etait l'ancre YAML `x-dev-auth`, et elle ne pouvait pas suivre : une ancre
# ne traverse pas `include:` — Compose leve « unknown anchor ». Un chemin de
# fichier, lui, traverse.
#
# Aucune de ces valeurs n'est un secret : c'est la pile de developpement. En
# production, `AesGcmSecretProtector` refuse de demarrer sans cle fournie.
#
# L'ancre existe toujours dans le dev pour les services qui n'ont pas bascule.
AUTHENTICATION__ISSUER=hba-identity
AUTHENTICATION__AUDIENCE=hba-platform
AUTHENTICATION__SIGNINGKEY=hba-development-signing-key-32bytes-minimum
INTERNAL__APIKEY=hba-development-internal-key
INTERNAL__IDENTITESNONSIGNEES=true
SECURITY__SECRETPROTECTION__KEY=qn3pI+unmhy+CoohrVuLMPSlwHniiS6yMfMknVsofdY=
