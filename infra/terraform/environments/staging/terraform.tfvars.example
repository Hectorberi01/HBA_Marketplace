# Copier en `terraform.tfvars` — qui est ignoré par Git.
#
# LES IDENTIFIANTS OVH NE SE METTENT PAS ICI.
#
# Les fournisseurs `ovh` et `openstack` les lisent dans l'environnement :
#
#   export OVH_ENDPOINT=ovh-eu
#   export OVH_APPLICATION_KEY=...
#   export OVH_APPLICATION_SECRET=...
#   export OVH_CONSUMER_KEY=...
#   export OS_AUTH_URL=https://auth.cloud.ovh.net/v3
#   export OS_USERNAME=...
#   export OS_PASSWORD=...
#   export OS_TENANT_ID=...
#
# Et le backend S3, séparément (ce sont d'AUTRES clés — celles du User S3 OVH) :
#
#   export AWS_ACCESS_KEY_ID=...
#   export AWS_SECRET_ACCESS_KEY=...
#
# Un secret écrit dans un `.tfvars` finit dans un dépôt le jour où quelqu'un
# retire une ligne du `.gitignore` sans savoir pourquoi elle y était.

service_name = "0123456789abcdef0123456789abcdef"

zone_dns = "hba-express.example"

cle_ssh_publique = "ssh-ed25519 AAAA... hector@hba"
