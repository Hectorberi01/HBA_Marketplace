# ═══════════════════════════════════════════════════════════════════════════════
# GABARIT DU FICHIER D'ENVIRONNEMENT DE PRODUCTION — 46 VARIABLES.
#
# ENGENDRE depuis docker-compose.prod.yml : chaque nom vient d'une reference
# ${VAR:?...} du compose, aucune n'est ecrite de memoire. Regenerer apres tout
# changement du compose.
#
# CE FICHIER NE DOIT JAMAIS ETRE COMMITE RENSEIGNE. Il est ici VIDE, et le
# `.gitignore` refuse toute copie portant des valeurs.
#
# LE `$` DANS UNE VALEUR DOIT ETRE DOUBLE. Compose interpole AUSSI ce fichier :
# `mot$depasse` y devient une reference vers une variable `depasse`, absente,
# donc vide — le service part avec un mot de passe TRONQUE et echoue sur une
# erreur qui parle d'authentification, jamais de `$`. Ecrire `mot$$depasse`.
#
# `HBA_TAG` N'EST PAS ICI : le workflow l'ajoute depuis son entree.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Domaine et TLS ────────────────────────────────────────────────────────────
HBA_DOMAINE=
HBA_ACME_EMAIL=

# ── Mots de passe des 13 bases (VPS 10.20.0.2, par le tunnel WireGuard) ───────
#
# Un role Postgres par base, jamais un role partage : un service compromis ne
# doit pouvoir lire que sa propre base.
HBA_CATALOG_PASSWORD=                        # hba_catalog
HBA_COMMERCE_PASSWORD=                       # hba_commerce
HBA_DELIVERY_PASSWORD=                       # hba_delivery
HBA_ENGAGEMENT_PASSWORD=                     # hba_engagement
HBA_FINANCIAL_PASSWORD=                      # hba_financial
HBA_FOOD_PASSWORD=                           # hba_food
HBA_IDENTITY_PASSWORD=                       # hba_identity
HBA_INVENTORY_PASSWORD=                      # hba_inventory
HBA_MEDIA_PASSWORD=                          # hba_media
HBA_MERCHANT_PASSWORD=                       # hba_merchant
HBA_ORDER_PASSWORD=                          # hba_order
HBA_PROMOTION_PASSWORD=                      # hba_promotion
HBA_USER_PASSWORD=                           # hba_user

# ── Identites gRPC internes (19) ───────────────────────────────────────────────
#
# Engendrees par scripts/generer-identites-internes.sh, qui produit AUSSI
# INTERNAL_PUBLIC_KEYS plus bas — le registre que chaque service consulte pour
# verifier ses interlocuteurs. Une identite absente et le service concerne ne
# peut plus se faire reconnaitre : les appels reviennent en NotFound, muets sur
# la cause.
INTERNAL_KEY_HBA_CATALOG_API=                # catalog-service
INTERNAL_KEY_HBA_COMMERCE_API=               # cart-service
INTERNAL_KEY_HBA_DELIVERY_CORE_API=          # delivery-service
INTERNAL_KEY_HBA_DELIVERY_DRIVER_API=        # driver-service
INTERNAL_KEY_HBA_DELIVERY_PRICING_API=       # delivery-pricing-service
INTERNAL_KEY_HBA_DELIVERY_ROUTE_API=         # route-service
INTERNAL_KEY_HBA_ENGAGEMENT_API=             # review-service
INTERNAL_KEY_HBA_FINANCIAL_API=              # payment-service
INTERNAL_KEY_HBA_FOOD_CART_API=              # food-cart-service
INTERNAL_KEY_HBA_FOOD_ORDER_API=             # food-order-service
INTERNAL_KEY_HBA_FOOD_RESTAURANT_API=        # restaurant-service
INTERNAL_KEY_HBA_GATEWAY_API=                # gateway
INTERNAL_KEY_HBA_IDENTITY_API=               # identity-service
INTERNAL_KEY_HBA_INVENTORY_API=              # inventory-service
INTERNAL_KEY_HBA_MEDIA_API=                  # media-service
INTERNAL_KEY_HBA_MERCHANTS_API=              # seller-service
INTERNAL_KEY_HBA_ORDER_API=                  # order-service
INTERNAL_KEY_HBA_PROMOTIONS_API=             # promotion-service
INTERNAL_KEY_HBA_USERS_API=                  # user-service

# ── Cles partagees par TOUS les services ──────────────────────────────────────
#
# AUTHENTICATION__SIGNINGKEY et JWT__SIGNINGKEY portent la MEME valeur :
# identity-service signe avec l'une, les dix-huit autres verifient avec l'autre.
# Deux valeurs differentes ne levent nulle part — tout appel authentifie revient
# en 401, sans cause nommee. Le workflow refuse le fichier si elles different.
#
# INTERNAL__APIKEY doit etre IDENTIQUE partout : l'appelant la presente, l'appele
# la compare.
#
# SECURITY__SECRETPROTECTION__KEY NE SE REGENERE PAS : ce qu'elle a chiffre ne se
# dechiffre pas avec la suivante.
AUTHENTICATION__SIGNINGKEY=
JWT__SIGNINGKEY=
INTERNAL__APIKEY=
INTERNAL_PUBLIC_KEYS=
SECURITY__SECRETPROTECTION__KEY=

# ── Compte administrateur amorce ──────────────────────────────────────────────
#
# notification-service n'est PAS deploye : aucun courriel ni SMS ne part, donc
# aucun mot de passe oublie. Ce compte est le SEUL moyen d'entrer.
ADMIN__PASSWORD=

# ── Stockage objet (MinIO) ────────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MEDIA__STORAGE__ACCESSKEYID=
MEDIA__STORAGE__SECRETACCESSKEY=

# ── Paiement (FedaPay) ────────────────────────────────────────────────────────
#
# Cle LIVE : elle deplace de l'argent reel.
PAYMENTS__FEDAPAY__APIKEY=
PAYMENTS__FEDAPAY__WEBHOOKSECRET=
