# ═══════════════════════════════════════════════════════════════════════════
# HBA — variables d'environnement, cible microservices
#
# MODÈLE UNIQUEMENT. Aucune valeur réelle ici, jamais.
#
# Une seule ligne de secret déposée dans un dépôt y reste, y compris après sa
# suppression : l'historique la garde. Ce fichier est versionné pour dire QUELLES
# variables existent ; les valeurs vivent dans le gestionnaire de secrets.
# ═══════════════════════════════════════════════════════════════════════════

# ── Bases : UNE PAR SERVICE, ET C'EST LA RÈGLE STRUCTURANTE ───────────────
# Une chaîne de connexion partagée entre deux services rétablit le couplage que
# la découpe cherche à supprimer — et rien ne l'empêcherait techniquement.
IDENTITY_DB_CONNECTION=
USER_DB_CONNECTION=
MERCHANT_DB_CONNECTION=
CATALOG_DB_CONNECTION=
INVENTORY_DB_CONNECTION=
FOOD_DB_CONNECTION=
COMMERCE_DB_CONNECTION=
ORDER_DB_CONNECTION=
DELIVERY_DB_CONNECTION=
FINANCIAL_DB_CONNECTION=
ENGAGEMENT_DB_CONNECTION=
COMMUNICATION_DB_CONNECTION=
MEDIA_DB_CONNECTION=

# ── Messagerie et cache ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SCHEMA_REGISTRY_URL=
REDIS_CONNECTION=

# ── Stockage objet (médias) ───────────────────────────────────────────────
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BUCKET=
OBJECT_STORAGE_PRIVATE_BUCKET=

# ── Barème plateforme ─────────────────────────────────────────────────────
# Deux taux distincts : une place de marché ne prélève pas sur un produit ce
# qu'un service de livraison de repas prélève sur une commande.
PRICING_PLATFORM_COMMISSION_RATE=
PRICING_PROVIDER_FEE_RATE=
PRICING_FOOD_COMMISSION_RATE=

# ── Services externes ─────────────────────────────────────────────────────
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
GEOCODING_API_KEY=

# ── Observabilité ─────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
